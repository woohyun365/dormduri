{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Hosted Renovate owns every version update and vulnerability fix PR (npm, GitHub Actions, Dockerfile and Compose images, and the .node-version file) and targets dev for CI validation.",
  "enabled": true,
  "enabledManagers": ["npm", "github-actions", "dockerfile", "docker-compose", "nodenv"],
  "baseBranchPatterns": ["dev"],
  "useBaseBranchConfig": "merge",
  "dependencyDashboard": true,
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "prConcurrentLimit": 5
  },
  "toolSettings": {
    "nodeMaxMemory": 1536
  },
  "commitMessagePrefix": "chore(deps): 의존성",
  "packageRules": [
    {
      "description": "Let Renovate squash-merge minor and patch updates, including vulnerability fixes, into dev once CI summary passes and the branch is up to date with dev. The automerge rules come first so a later group rule can set automerge to false for its group.",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge Docker Hub digest updates too: re-pushing a tag restarts minimumReleaseAge there. A GitHub Actions digest update (a moved tag) can pass minimumReleaseAge at once, so it waits for review.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    },
    {
      "description": "Group compatible lint and local developer tooling minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@eslint/js",
        "@swc/cli",
        "@swc/core",
        "@types/node",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint",
        "eslint-config-prettier",
        "globals",
        "husky",
        "lint-staged",
        "prettier",
        "typescript",
        "typescript-eslint",
        "unplugin-swc"
      ],
      "groupName": "lint-tooling",
      "groupSlug": "lint-tooling"
    },
    {
      "description": "Group compatible Web framework and rendering dependency minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@sentry/nextjs",
        "@tabler/icons-react",
        "@tailwindcss/postcss",
        "@types/react",
        "@types/react-dom",
        "babel-plugin-react-compiler",
        "eslint-config-next",
        "lucide-react",
        "motion",
        "next",
        "react",
        "react-dom",
        "sonner",
        "tailwindcss"
      ],
      "groupName": "web-framework",
      "groupSlug": "web-framework"
    },
    {
      "description": "Group compatible Web test and Storybook minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@axe-core/playwright",
        "@babel/core",
        "@playwright/test",
        "@rolldown/plugin-babel",
        "@storybook/addon-docs",
        "@storybook/nextjs-vite",
        "@testing-library/jest-dom",
        "@testing-library/react",
        "@testing-library/user-event",
        "@vitejs/plugin-react",
        "@vitest/coverage-v8",
        "jsdom",
        "storybook",
        "vite",
        "vitest"
      ],
      "groupName": "web-test-storybook",
      "groupSlug": "web-test-storybook"
    },
    {
      "description": "Hold @rolldown/plugin-babel inside the @vitejs/plugin-react peer range (^0.1.7 || ^0.2.0) so an out-of-range release never reaches dev on its own. Lift or widen this rule in the update that widens the @vitejs/plugin-react peer range.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@rolldown/plugin-babel"],
      "allowedVersions": "<0.3.0"
    },
    {
      "description": "Group compatible API framework minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@nestjs/cli",
        "@nestjs/common",
        "@nestjs/config",
        "@nestjs/core",
        "@nestjs/platform-express",
        "@nestjs/platform-socket.io",
        "@nestjs/schedule",
        "@nestjs/schematics",
        "@nestjs/testing",
        "@nestjs/throttler",
        "@nestjs/websockets"
      ],
      "groupName": "api-framework",
      "groupSlug": "api-framework"
    },
    {
      "description": "Group compatible API persistence minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@prisma/adapter-pg", "@prisma/client", "@types/pg", "pg", "prisma"],
      "groupName": "api-persistence",
      "groupSlug": "api-persistence"
    },
    {
      "description": "Group compatible API runtime and provider minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@aws-sdk/client-secrets-manager",
        "@aws-sdk/client-sesv2",
        "@node-rs/argon2",
        "@types/express",
        "cron",
        "dotenv",
        "helmet",
        "joi",
        "pino",
        "reflect-metadata",
        "rxjs",
        "socket.io",
        "source-map-support"
      ],
      "groupName": "api-runtime",
      "groupSlug": "api-runtime"
    },
    {
      "description": "Group compatible API observability minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@prometheus-io/client"],
      "groupName": "api-observability",
      "groupSlug": "api-observability"
    },
    {
      "description": "Group compatible shared contract minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["zod"],
      "groupName": "shared-contract",
      "groupSlug": "shared-contract"
    },
    {
      "description": "Group compatible API test-tooling minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@types/supertest", "supertest"],
      "groupName": "api-test-tooling",
      "groupSlug": "api-test-tooling"
    },
    {
      "description": "Group GitHub Actions minor/patch updates; every action stays pinned to a full commit SHA with its version comment.",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-tags"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "actions-minor-patch",
      "groupSlug": "actions-minor-patch",
      "commitMessagePrefix": "ci(deps): 의존성"
    },
    {
      "description": "Keep the local, rehearsal and CI service PostgreSQL pins on one tag and digest in a single PR.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "postgres-image",
      "groupSlug": "postgres-image"
    },
    {
      "description": "Keep the API, Web and fixture Node.js base images and the local .node-version on one Node.js line in a single PR.",
      "matchDatasources": ["docker", "node-version"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "node-image",
      "groupSlug": "node-image"
    },
    {
      "description": "Group observability stack image minor/patch and digest updates.",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["infra/observability/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "observability-images",
      "groupSlug": "observability-images"
    },
    {
      "description": "Require an explicit dependency-dashboard decision for every major update in every manager; major updates never automerge.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Keep the ESLint core pair on one dashboard approval line: eslint and @eslint/js majors move together on one branch and never automerge. This is the only major group.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["eslint", "@eslint/js"],
      "groupName": "eslint-major",
      "groupSlug": "eslint-major",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Put every pnpm package-manager update, in the root packageManager and the CI pnpm/action-setup version input, on one dashboard approval line and branch. Compare the cold lockfile benchmark before approving; a person merges the PR after CI.",
      "matchManagers": ["npm", "github-actions"],
      "matchDepTypes": ["packageManager", "uses-with"],
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm-package-manager",
      "groupSlug": "pnpm-package-manager",
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
