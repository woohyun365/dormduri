{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Hosted Renovate owns pnpm dependency version updates and targets dev for CI validation.",
  "enabled": true,
  "enabledManagers": ["npm"],
  "baseBranchPatterns": ["dev"],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "toolSettings": {
    "nodeMaxMemory": 1536
  },
  "commitMessagePrefix": "chore(deps): 의존성",
  "packageRules": [
    {
      "description": "Group compatible lint and local developer tooling minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@eslint/js",
        "@swc/cli",
        "@swc/core",
        "@types/node",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint",
        "eslint-config-prettier",
        "globals",
        "husky",
        "lint-staged",
        "prettier",
        "ts-node",
        "typescript",
        "typescript-eslint",
        "unplugin-swc"
      ],
      "groupName": "lint-tooling",
      "groupSlug": "lint-tooling"
    },
    {
      "description": "Group compatible Web framework and rendering dependency minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@sentry/nextjs",
        "@tabler/icons-react",
        "@tailwindcss/postcss",
        "@types/react",
        "@types/react-dom",
        "eslint-config-next",
        "lucide-react",
        "motion",
        "next",
        "react",
        "react-dom",
        "sonner",
        "tailwindcss"
      ],
      "groupName": "web-framework",
      "groupSlug": "web-framework"
    },
    {
      "description": "Group compatible Web test and Storybook minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@axe-core/playwright",
        "@playwright/test",
        "@storybook/addon-docs",
        "@storybook/nextjs-vite",
        "@testing-library/jest-dom",
        "@testing-library/react",
        "@testing-library/user-event",
        "@vitejs/plugin-react",
        "@vitest/coverage-v8",
        "jsdom",
        "storybook",
        "vite",
        "vitest"
      ],
      "groupName": "web-test-storybook",
      "groupSlug": "web-test-storybook"
    },
    {
      "description": "Group compatible API framework minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@nestjs/cli",
        "@nestjs/common",
        "@nestjs/config",
        "@nestjs/core",
        "@nestjs/platform-express",
        "@nestjs/platform-socket.io",
        "@nestjs/schedule",
        "@nestjs/schematics",
        "@nestjs/testing",
        "@nestjs/throttler",
        "@nestjs/websockets"
      ],
      "groupName": "api-framework",
      "groupSlug": "api-framework"
    },
    {
      "description": "Group compatible API persistence minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@prisma/adapter-pg", "@prisma/client", "@types/pg", "pg", "prisma"],
      "groupName": "api-persistence",
      "groupSlug": "api-persistence"
    },
    {
      "description": "Group compatible API runtime and provider minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@aws-sdk/client-secrets-manager",
        "@aws-sdk/client-sesv2",
        "@node-rs/argon2",
        "@types/express",
        "cron",
        "dotenv",
        "helmet",
        "joi",
        "pino",
        "reflect-metadata",
        "rxjs",
        "socket.io",
        "source-map-support"
      ],
      "groupName": "api-runtime",
      "groupSlug": "api-runtime"
    },
    {
      "description": "Group compatible API observability minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@prometheus-io/client"],
      "groupName": "api-observability",
      "groupSlug": "api-observability"
    },
    {
      "description": "Group compatible shared contract minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["zod"],
      "groupName": "shared-contract",
      "groupSlug": "shared-contract"
    },
    {
      "description": "Group compatible API test-tooling minor/patch updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@types/supertest", "supertest"],
      "groupName": "api-test-tooling",
      "groupSlug": "api-test-tooling"
    },
    {
      "description": "Require an explicit dependency-dashboard decision for every major update.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "revisit: enable TypeScript 7 only after Next.js, NestJS, ESLint, and the repository compiler toolchain declare compatible support.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["typescript"],
      "enabled": false
    },
    {
      "description": "revisit: enable ESLint 10 only after eslint-plugin-import, eslint-plugin-jsx-a11y, eslint-plugin-react, and every repository config consumer declare compatible support.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["eslint", "@eslint/js"],
      "enabled": false
    },
    {
      "description": "revisit: keep pnpm package-manager upgrades manual until the CLI, lockfile, Corepack, and CI action are reviewed together.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["packageManager"],
      "matchPackageNames": ["pnpm"],
      "enabled": false
    }
  ]
}
