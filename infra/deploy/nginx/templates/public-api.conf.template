# Generated by the ingress renderer. Unknown public authorities never select private behavior.
server {
  __DEFAULT_LISTEN__
  server_name _;
  __API_TLS__
  return 444;
}

server {
  __PUBLIC_LISTEN__
  server_name __API_HOST__;
  __API_TLS__
  if ($http_host !~* "^__API_HOST_PATTERN__$") { return 444; }
  client_max_body_size 1m;

  location = /health {
    proxy_pass http://__API_UPSTREAM__/health;
    __PUBLIC_API_HEADERS__
  }
  location = /health/live {
    proxy_pass http://__API_UPSTREAM__/health/live;
    __PUBLIC_API_HEADERS__
  }
  location = /health/ready {
    proxy_pass http://__API_UPSTREAM__/health/ready;
    __PUBLIC_API_HEADERS__
  }
  location = /internal/metrics {
    include /etc/nginx/snippets/internal-metrics-allowlist.conf;
    proxy_pass http://__API_UPSTREAM__/internal/metrics;
    proxy_set_header Authorization $http_authorization;
    __PUBLIC_API_HEADERS__
  }
  location /api/ {
    proxy_pass http://__API_UPSTREAM__;
    __PUBLIC_API_HEADERS__
  }
  location /auth/ {
    proxy_pass http://__API_UPSTREAM__;
    __PUBLIC_API_HEADERS__
  }
  location /socket.io/ {
    proxy_pass http://__API_UPSTREAM__;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    __PUBLIC_API_HEADERS__
  }
  location / { return 404; }
}
