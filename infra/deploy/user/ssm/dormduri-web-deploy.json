{
  "schemaVersion": "2.2",
  "description": "dormduri Web bundle deploy: deploy, rollback or maintenance with a digest pair. No free-form commands.",
  "parameters": {
    "action": {
      "type": "String",
      "description": "deploy | rollback | maintenance",
      "interpolationType": "ENV_VAR",
      "allowedValues": [
        "deploy",
        "rollback",
        "maintenance"
      ]
    },
    "webDigest": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^sha256:[a-f0-9]{64}$",
      "description": "dormduri/web image digest (sha256:...)"
    },
    "ingressDigest": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^sha256:[a-f0-9]{64}$",
      "description": "dormduri/ingress image digest (sha256:...)"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "deploy",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "900",
        "runCommand": [
          "#!/usr/bin/env bash",
          "# dormduri-web-deploy 본문(web 묶음: web·ingress). scripts/infra/user-host/ssm-document.mjs가 이 파일, lib.sh,",
          "# ../compose.yml(web 묶음 조각)로 SSM Command document(dormduri-web-deploy.json)를 만든다. 파라미터는 interpolationType",
          "# ENV_VAR로 SSM_action·SSM_webDigest·SSM_ingressDigest 환경 변수로만 받는다(shell에 끼워 넣지 않음). 임의 명령을 받지 않는다.",
          "# 표준 출력은 SSM 결과로 deploy role에 보이므로 RESULT 줄과 digest만 쓴다. registry 주소가 들어가는 docker·compose 출력은",
          "# root 전용 host log(/opt/dormduri/state/deploy.log)에만 남긴다.",
          "# release 기록·조각·compose 규칙은 lib.sh 머리말. API 묶음 `current`가 있으면 그 조각을 함께 넘기고 web·ingress만 다룬다.",
          "# 종료 코드: 0 성공, 1 실패(되돌림 또는 점검 mode), 2 입력·상태 거부, 75 다른 배포가 실행 중(host lock).",
          "set -euo pipefail",
          "umask 022",
          "export HOME=/root",
          "export AWS_SHARED_CREDENTIALS_FILE=/root/.aws/credentials",
          "export AWS_REGION=ap-northeast-2",
          "export AWS_DEFAULT_REGION=ap-northeast-2",
          "export PATH=/snap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
          "",
          "base=/opt/dormduri",
          "state=${base}/state",
          "mode_dir=${base}/mode",
          "log=${state}/deploy.log",
          "project=dormduri-web",
          "host=dormduri.com",
          "document_name=dormduri-web-deploy",
          "document_source=6320b51b56bf4803a634c9ffb00af721ff7d9385b22d79a136f43b8a09d5c49c",
          "digest_re='^sha256:[a-f0-9]{64}$'",
          "",
          "action=${SSM_action:-}",
          "web=${SSM_webDigest:-}",
          "ingress=${SSM_ingressDigest:-}",
          "case \"${action}\" in deploy | rollback | maintenance) ;; *)",
          "  echo \"RESULT=rejected reason=action\"",
          "  exit 2",
          "  ;;",
          "esac",
          "if ! [[ ${web} =~ ${digest_re} && ${ingress} =~ ${digest_re} ]]; then",
          "  echo \"RESULT=rejected reason=digest\"",
          "  exit 2",
          "fi",
          "",
          "# host lock: 상태를 바꾸는 실행은 둘 겹치지 않는다(API document와 같은 lock). 못 잡으면 아무것도 바꾸지 않고 75로 끝난다.",
          "install -d -m 0700 \"${state}\"",
          "exec 9>\"${state}/lock\"",
          "if ! flock -n 9; then",
          "  echo \"RESULT=locked action=${action}\"",
          "  exit 75",
          "fi",
          "install -d -m 0755 \"${mode_dir}\"",
          "",
          "# user host 배포 document 공통 함수. scripts/infra/user-host/ssm-document.mjs가 이 파일을 두 document(web 묶음",
          "# deploy.sh, API 묶음 ../api/ssm/deploy-api.sh)의 `#__USER_HOST_LIB__` 자리에 그대로 넣는다. 혼자 실행하지 않는다.",
          "# 부르는 쪽이 정하는 값: action, log, state, base, project, document_name, document_source.",
          "#",
          "# release 묶음(D-AB11): web 묶음(web·ingress)과 API 묶음(api·migrate one-off)은 같은 compose project의 조각 둘이다.",
          "# 묶음마다 host 상태 `current`·`previous`는 release 기록(key=value 줄)이다.",
          "#   recordFormat=2              이 형식을 쓴 document가 남긴 기록(옛 web document가 쓴 기록에는 없다)",
          "#   release=<id>                release 이름(release 기록 디렉터리 이름)",
          "#   <image 이름>=sha256:...      service image digest 표(web 묶음: web·ingress, API 묶음: api·api-migrate)",
          "#   fragment=<절대 경로>         그 release를 띄운 compose 조각 사본",
          "#   secretRelease=<id>          (API 묶음) runtime secret release",
          "#   document=<이름>, documentSource=<sha256>  그 release를 띄운 document와 원본 hash",
          "# compose는 두 묶음의 조각을 함께 넘기고(자기 묶음은 이번 조각, 다른 묶음은 기록된 `current` 조각) 자기 묶음 service만",
          "# `up`·`stop`·`rm`한다. project 전체 `down`은 쓰지 않는다. `--remove-orphans`는 두 조각을 다 넘긴 `up`에서만 쓴다.",
          "",
          "digest_re='^sha256:[a-f0-9]{64}$'",
          "releases=${base}/releases",
          "web_state=${state}",
          "api_state=${state}/api",
          "api_transit_name=dormduri-api-transit",
          "api_transit_subnet=10.217.11.0/28",
          "api_transit_range=10.217.11.8/29",
          "api_transit_gateway=10.217.11.1",
          "web_fragment=''",
          "api_fragment=''",
          "",
          "say() {",
          "  local line",
          "  line=\"$(date -u +%Y-%m-%dT%H:%M:%SZ) $*\"",
          "  printf '%s\\n' \"${line}\"",
          "  printf '%s\\n' \"${line}\" >>\"${log}\"",
          "}",
          "fail() {",
          "  say \"RESULT=failed action=${action} reason=$1\"",
          "  exit \"${2:-1}\"",
          "}",
          "",
          "# host log는 5MiB를 넘으면 한 번 돌린다(root 전용, 바깥으로 보내지 않음).",
          "rotate_log() {",
          "  if [ -f \"${log}\" ] && [ \"$(stat -c %s \"${log}\")\" -gt 5242880 ]; then mv -f \"${log}\" \"${log}.1\"; fi",
          "}",
          "",
          "record_get() {",
          "  [ -f \"$1\" ] || return 1",
          "  sed -n \"s/^$2=//p\" \"$1\" | tail -n 1",
          "}",
          "record_is_current_format() {",
          "  [ -f \"$1\" ] && grep -qx 'recordFormat=2' \"$1\"",
          "}",
          "# 기록 파일을 원자적으로 바꾼다(같은 디렉터리의 임시 파일 → mv).",
          "record_put() {",
          "  cat \"$2\" >\"$1.tmp\"",
          "  mv \"$1.tmp\" \"$1\"",
          "}",
          "",
          "# registry login(host credential, ECR). 주소는 host log에만 남는다.",
          "registry_init() {",
          "  local account",
          "  account=$(aws sts get-caller-identity --query Account --output text 2>>\"${log}\") || fail sts",
          "  registry=\"${account}.dkr.ecr.${AWS_REGION}.amazonaws.com\"",
          "  trap registry_cleanup EXIT",
          "}",
          "registry_cleanup() {",
          "  docker logout \"${registry}\" >/dev/null 2>&1 || true",
          "  if [ -n \"${cleanup_hook:-}\" ]; then \"${cleanup_hook}\" || true; fi",
          "}",
          "registry_login() {",
          "  aws ecr get-login-password 2>>\"${log}\" | docker login --username AWS --password-stdin \"${registry}\" >>\"${log}\" 2>&1",
          "}",
          "ref() { printf '%s/dormduri/%s@%s' \"${registry}\" \"$1\" \"$2\"; }",
          "",
          "# 묶음을 건너는 API transit network. 없을 때만 고정 subnet으로 만들고, 있으면 subnet이 같은지만 본다.",
          "ensure_api_transit() {",
          "  local inspected subnet",
          "  if inspected=$(docker network inspect \"${api_transit_name}\" 2>>\"${log}\"); then",
          "    subnet=$(printf '%s' \"${inspected}\" | python3 -c '",
          "import json, sys",
          "networks = json.load(sys.stdin)",
          "print(\" \".join(item.get(\"Subnet\", \"\") for net in networks for item in (net.get(\"IPAM\", {}).get(\"Config\") or [])))",
          "') || fail network-mismatch 2",
          "    [ \"${subnet}\" = \"${api_transit_subnet}\" ] || fail network-mismatch 2",
          "    return 0",
          "  fi",
          "  docker network create --driver bridge --subnet \"${api_transit_subnet}\" --ip-range \"${api_transit_range}\" \\",
          "    --gateway \"${api_transit_gateway}\" --label dormduri.user-host.network=api-transit \"${api_transit_name}\" \\",
          "    >>\"${log}\" 2>&1 || fail network-create",
          "}",
          "",
          "# 두 조각을 넘기는 compose. 조각 변수는 use_web_record·use_api_record가 정한다.",
          "run_compose() {",
          "  if [ -n \"${api_fragment}\" ]; then set -- -f \"${api_fragment}\" \"$@\"; fi",
          "  if [ -n \"${web_fragment}\" ]; then set -- -f \"${web_fragment}\" \"$@\"; fi",
          "  docker compose -p \"${project}\" \"$@\" >>\"${log}\" 2>&1",
          "}",
          "# `--remove-orphans`는 두 조각을 다 넘겼을 때만 붙인다.",
          "orphan_flag() {",
          "  if [ -n \"${web_fragment}\" ] && [ -n \"${api_fragment}\" ]; then printf '%s' --remove-orphans; fi",
          "}",
          "",
          "web_release_of() { printf 'web-%s' \"${1:7:12}\"; }",
          "",
          "# web 묶음 기록으로 compose 변수를 정한다. 기록이 없으면 web 조각을 넘기지 않는다.",
          "use_web_record() {",
          "  local web ingress fragment",
          "  if [ -z \"$1\" ] || [ ! -f \"$1\" ]; then",
          "    web_fragment=''",
          "    return 0",
          "  fi",
          "  web=$(record_get \"$1\" web)",
          "  ingress=$(record_get \"$1\" ingress)",
          "  fragment=$(record_get \"$1\" fragment)",
          "  [[ ${web} =~ ${digest_re} && ${ingress} =~ ${digest_re} ]] || return 1",
          "  [ -n \"${fragment}\" ] && [ -s \"${fragment}\" ] || return 1",
          "  web_fragment=${fragment}",
          "  export WEB_IMAGE INGRESS_IMAGE WEB_RELEASE",
          "  WEB_IMAGE=$(ref web \"${web}\")",
          "  INGRESS_IMAGE=$(ref ingress \"${ingress}\")",
          "  WEB_RELEASE=$(web_release_of \"${web}\")",
          "}",
          "",
          "# API 묶음 기록으로 compose 변수를 정한다. 기록이 없으면 API 조각을 넘기지 않는다.",
          "use_api_record() {",
          "  local api migrate fragment secret",
          "  if [ -z \"$1\" ] || [ ! -f \"$1\" ]; then",
          "    api_fragment=''",
          "    return 0",
          "  fi",
          "  api=$(record_get \"$1\" api)",
          "  migrate=$(record_get \"$1\" api-migrate)",
          "  fragment=$(record_get \"$1\" fragment)",
          "  secret=$(record_get \"$1\" secretRelease)",
          "  [[ ${api} =~ ${digest_re} && ${migrate} =~ ${digest_re} ]] || return 1",
          "  [ -n \"${fragment}\" ] && [ -s \"${fragment}\" ] && [ -n \"${secret}\" ] || return 1",
          "  api_fragment=${fragment}",
          "  export API_IMAGE API_MIGRATE_IMAGE API_SECRET_RELEASE_DIR",
          "  API_IMAGE=$(ref api \"${api}\")",
          "  API_MIGRATE_IMAGE=$(ref api-migrate \"${migrate}\")",
          "  API_SECRET_RELEASE_DIR=${base}/secrets/api/releases/${secret}",
          "}",
          "",
          "# 옛 web document가 쓴 기록(조각 줄 없음)에 그 release가 쓴 compose 사본을 조각 기록으로 붙인다(형식 표지는 붙이지 않는다).",
          "# 옛 document는 매 배포마다 같은 파일(/opt/dormduri/compose/compose.yml)에 compose를 썼고 rollback도 그 파일을 썼다.",
          "adopt_legacy_web_records() {",
          "  local name file web ingress dir legacy_compose=${base}/compose/compose.yml",
          "  for name in current previous; do",
          "    file=${web_state}/${name}",
          "    [ -f \"${file}\" ] || continue",
          "    if grep -q '^fragment=' \"${file}\"; then continue; fi",
          "    web=$(record_get \"${file}\" web)",
          "    ingress=$(record_get \"${file}\" ingress)",
          "    [[ ${web} =~ ${digest_re} && ${ingress} =~ ${digest_re} ]] || fail legacy-record 2",
          "    [ -s \"${legacy_compose}\" ] || fail legacy-compose-missing 2",
          "    dir=${releases}/web/legacy-${web:7:12}-${ingress:7:12}",
          "    install -d -m 0755 \"${dir}\"",
          "    [ -s \"${dir}/compose.yml\" ] || cp \"${legacy_compose}\" \"${dir}/compose.yml\"",
          "    { cat \"${file}\"; printf 'fragment=%s\\n' \"${dir}/compose.yml\"; } >\"${file}.tmp\"",
          "    mv \"${file}.tmp\" \"${file}\"",
          "  done",
          "}",
          "",
          "# 기록이 가리키지 않는 release 기록 디렉터리를 지운다(current·previous가 가리키는 것만 남긴다).",
          "prune_release_dirs() {",
          "  local kind=$1 keep=' ' dir fragment record",
          "  shift",
          "  for record in \"$@\"; do",
          "    fragment=$(record_get \"${record}\" fragment || true)",
          "    [ -n \"${fragment}\" ] && keep=\"${keep}$(dirname \"${fragment}\") \"",
          "  done",
          "  for dir in \"${releases}/${kind}\"/*; do",
          "    [ -d \"${dir}\" ] || continue",
          "    case \"${keep}\" in *\" ${dir} \"*) ;; *) rm -rf \"${dir}\" ;; esac",
          "  done",
          "}",
          "",
          "# 자기 묶음 repository의 image 가운데 keep 목록 밖의 것만 지운다(다른 묶음 image는 건드리지 않는다).",
          "prune_repository_images() {",
          "  local repos=$1 keep=$2",
          "  docker image ls --digests --format json | KEEP=\"${keep}\" REG=\"${registry}\" REPOS=\"${repos}\" python3 -c '",
          "import json, os, sys",
          "keep = set(os.environ[\"KEEP\"].split())",
          "repos = {os.environ[\"REG\"] + \"/dormduri/\" + name for name in os.environ[\"REPOS\"].split()}",
          "for line in sys.stdin:",
          "    img = json.loads(line)",
          "    repo, digest = img.get(\"Repository\", \"\"), img.get(\"Digest\", \"\")",
          "    if repo in repos and digest.startswith(\"sha256:\") and repo + \"@\" + digest not in keep:",
          "        print(img[\"ID\"])",
          "' | sort -u | xargs -r docker image rm >>\"${log}\" 2>&1 || true",
          "}",
          "",
          "rotate_log",
          "say \"START action=${action} web=${web} ingress=${ingress}\"",
          "",
          "[ -s \"${base}/tls/fullchain.pem\" ] && [ -s \"${base}/tls/privkey.pem\" ] || fail tls-missing 2",
          "",
          "registry_init",
          "adopt_legacy_web_records",
          "ensure_api_transit",
          "# API 묶음 `current`가 있으면 그 기록의 조각·변수를 함께 넘긴다(없으면 web 조각만).",
          "use_api_record \"${api_state}/current\" || fail api-record 2",
          "",
          "# 이번 실행의 web 묶음 release 기록: 조각 사본과 기록 파일을 release 디렉터리에 둔다. 이름에 PID를 붙여 같은 초에 같은",
          "# digest로 다시 실행해도 기록된 release 디렉터리(rollback 대상의 조각)와 겹치지 않게 한다.",
          "new_release=web-$(date -u +%Y%m%dT%H%M%SZ)-${web:7:12}-$$",
          "new_dir=${releases}/web/${new_release}",
          "install -d -m 0755 \"${new_dir}\"",
          "cat >\"${new_dir}/compose.yml.tmp\" <<'COMPOSE'",
          "# User host web 묶음 compose 조각(web·ingress, 동작 설명: infra/deploy/README.md 'User host 묶음'). web 배포 document",
          "# (ssm/deploy.sh)가 이 조각을 document 안에 담아 release 기록 디렉터리(`/opt/dormduri/releases/web/<release>/compose.yml`)에",
          "# 쓰고, 그 release의 기록이 이 조각을 가리킨다. rollback은 기록된 조각으로 띄운다. 그래서 document 해시가 실행 구성을",
          "# 고정하고, document가 바뀐 뒤에도 옛 release는 옛 조각으로 뜬다.",
          "# API 묶음 조각(api/compose.yml)과 같은 project(`dormduri-web`)로 함께 넘긴다. 이 조각만 top-level `name:`을 둔다.",
          "# image는 registry digest 참조만 받는다. registry 주소는 document가 host credential로 정하고 이 파일에 적지 않는다.",
          "# 경로는 host 절대 경로만 쓴다(두 조각을 서로 다른 release 디렉터리에서 함께 넘기므로 상대 경로를 두지 않는다).",
          "# host 경로(`/opt/dormduri/...`)는 Lightsail host 준비가 만든다. 로컬 rehearsal은 infra/rehearsal/compose.user-host.yml이 덮어쓴다.",
          "name: dormduri-web",
          "",
          "services:",
          "  web:",
          "    image: ${WEB_IMAGE:?WEB_IMAGE must be a registry digest reference}",
          "    environment:",
          "      NODE_ENV: production",
          "      HOSTNAME: 0.0.0.0",
          "      PORT: '3000'",
          "      TZ: Asia/Seoul",
          "      WEB_APP_URL: https://dormduri.com",
          "      # ingress private listener(8081)가 Web container만 받아 API로 보낸다. API가 없거나 응답하지 않으면 JSON 503이다.",
          "      API_URL: http://ingress:8081",
          "      WEB_OBSERVABILITY_ENVIRONMENT: production",
          "      WEB_RELEASE: ${WEB_RELEASE:?WEB_RELEASE must identify the web digest}",
          "    # host에 publish하지 않는다. Web transit에서 ingress만 닿는다.",
          "    expose:",
          "      - '3000'",
          "    restart: unless-stopped",
          "    init: true",
          "    read_only: true",
          "    tmpfs:",
          "      - /tmp:size=64m,mode=1777",
          "      # Next.js 이미지 최적화 cache. tmpfs라 container memory 한도(320MiB)에 함께 잡힌다.",
          "      - /app/apps/web/.next/cache:size=128m,mode=1777",
          "    cap_drop:",
          "      - ALL",
          "    security_opt:",
          "      - no-new-privileges:true",
          "    stop_grace_period: 15s",
          "    networks:",
          "      web-transit:",
          "        # ingress private listener가 이 주소 하나만 받는다(ingress/conf.d/dormduri.conf).",
          "        ipv4_address: 10.217.10.2",
          "    logging:",
          "      driver: json-file",
          "      options:",
          "        max-size: '10m'",
          "        max-file: '3'",
          "    deploy:",
          "      resources:",
          "        limits:",
          "          memory: 320M",
          "          pids: 256",
          "",
          "  ingress:",
          "    image: ${INGRESS_IMAGE:?INGRESS_IMAGE must be a registry digest reference}",
          "    ports:",
          "      - '80:8080'",
          "      - '443:8443'",
          "    volumes:",
          "      - /opt/dormduri/acme-webroot:/var/www/acme:ro",
          "      - /opt/dormduri/tls:/etc/dormduri-tls:ro",
          "      - /opt/dormduri/mode:/run/dormduri-mode:ro",
          "    restart: unless-stopped",
          "    init: true",
          "    read_only: true",
          "    tmpfs:",
          "      - /tmp:size=16m,mode=1777",
          "    cap_drop:",
          "      - ALL",
          "    security_opt:",
          "      - no-new-privileges:true",
          "    stop_grace_period: 15s",
          "    healthcheck:",
          "      test: ['CMD', 'wget', '-q', '-O', '/dev/null', 'http://127.0.0.1:8081/__ingress/health']",
          "      interval: 15s",
          "      timeout: 3s",
          "      start_period: 5s",
          "      retries: 3",
          "    networks:",
          "      web-transit:",
          "        # private listener는 이 주소에만 listen한다. 다른 network의 peer는 연결 자체가 거부된다.",
          "        ipv4_address: 10.217.10.3",
          "      api-transit: {}",
          "    logging:",
          "      driver: json-file",
          "      options:",
          "        max-size: '10m'",
          "        max-file: '3'",
          "    deploy:",
          "      resources:",
          "        limits:",
          "          memory: 96M",
          "          pids: 128",
          "",
          "networks:",
          "  # Web transit: web·ingress만 붙는다. 지금 production의 옛 `web` network(옛 형식 release가 쓰는 정의)는 다시 정의하지",
          "  # 않는다. subnet은 RDS가 있는 default VPC·Lightsail VPC·Docker 기본 주소 pool과 겹치지 않게 골랐고, 고정 주소(.2·.3)는",
          "  # 동적 할당 범위(ip_range) 밖이다.",
          "  web-transit:",
          "    driver: bridge",
          "    ipam:",
          "      config:",
          "        - subnet: 10.217.10.0/28",
          "          ip_range: 10.217.10.8/29",
          "          gateway: 10.217.10.1",
          "  # API transit: ingress·api가 붙는 묶음을 건너는 host network. 두 document가 compose 전에 없을 때만 같은 subnet으로",
          "  # 만들고(이름·subnet이 다르면 멈춤) 두 조각은 external로만 쓴다.",
          "  api-transit:",
          "    external: true",
          "    name: dormduri-api-transit",
          "COMPOSE",
          "mv \"${new_dir}/compose.yml.tmp\" \"${new_dir}/compose.yml\"",
          "printf 'recordFormat=2\\nrelease=%s\\nweb=%s\\ningress=%s\\nfragment=%s\\ndocument=%s\\ndocumentSource=%s\\n' \\",
          "  \"${new_release}\" \"${web}\" \"${ingress}\" \"${new_dir}/compose.yml\" \"${document_name}\" \"${document_source}\" \\",
          "  >\"${new_dir}/record\"",
          "",
          "pull_pair() {",
          "  registry_login || return 1",
          "  docker pull -q \"$(ref web \"$1\")\" >>\"${log}\" 2>&1 || return 1",
          "  docker pull -q \"$(ref ingress \"$2\")\" >>\"${log}\" 2>&1",
          "}",
          "",
          "# 내부 smoke: host loopback으로 canonical host에 요청해 status와 정적 화면 제목을 본다(바깥 smoke는 CD가 따로 한다).",
          "page_ok() {",
          "  local path=$1 want_code=$2 want_title=${3:-} body code",
          "  body=$(mktemp)",
          "  code=$(curl -s -o \"${body}\" -w '%{http_code}' --max-time 10 --resolve \"${host}:443:127.0.0.1\" \"https://${host}${path}\" || true)",
          "  if [ \"${code}\" != \"${want_code}\" ]; then",
          "    rm -f \"${body}\"",
          "    return 1",
          "  fi",
          "  if [ -n \"${want_title}\" ] && ! grep -qF \"<title>${want_title}</title>\" \"${body}\"; then",
          "    rm -f \"${body}\"",
          "    return 1",
          "  fi",
          "  rm -f \"${body}\"",
          "}",
          "",
          "smoke_serving() {",
          "  page_ok / 200 && page_ok /privacy 200 && page_ok /terms 200 \\",
          "    && page_ok /signup 503 '돔두리 — 준비 중' \\",
          "    && page_ok /__smoke_not_allowed 404 '돔두리 — 페이지를 찾을 수 없어요'",
          "}",
          "",
          "smoke_maintenance() {",
          "  page_ok / 503 '돔두리 — 점검 중' && page_ok /privacy 503 '돔두리 — 점검 중'",
          "}",
          "",
          "# 기록 하나의 web 묶음을 띄운다(API 묶음은 기록된 current 조각을 함께 넘기기만 한다).",
          "start_record() {",
          "  rm -f \"${mode_dir}/maintenance\"",
          "  use_web_record \"$1\" || return 1",
          "  run_compose up -d $(orphan_flag) --wait --wait-timeout 120 web ingress || return 1",
          "  smoke_serving",
          "}",
          "",
          "# 점검 mode: flag를 두고 ingress만 띄운 뒤 Web을 내린다. ingress마저 뜨지 않으면 web 묶음 service만 멈추고 지운다",
          "# (API 묶음 container는 건드리지 않는다. Web 단계는 공개 출시 전이라 그 동안의 연결 거부를 받아들인다).",
          "enter_maintenance() {",
          "  touch \"${mode_dir}/maintenance\"",
          "  chmod 0644 \"${mode_dir}/maintenance\"",
          "  if use_web_record \"$1\" && run_compose up -d --no-deps --wait --wait-timeout 60 ingress && smoke_maintenance; then",
          "    run_compose stop web || true",
          "    return 0",
          "  fi",
          "  run_compose stop web ingress || true",
          "  run_compose rm -f web ingress || true",
          "  return 1",
          "}",
          "",
          "prune_images() {",
          "  local keep=' ' record digest name",
          "  for record in \"$@\"; do",
          "    for name in web ingress; do",
          "      digest=$(record_get \"${record}\" \"${name}\" || true)",
          "      [ -n \"${digest}\" ] && keep=\"${keep} $(ref \"${name}\" \"${digest}\")\"",
          "    done",
          "  done",
          "  prune_repository_images 'web ingress' \"${keep}\"",
          "}",
          "",
          "finish_records() {",
          "  prune_release_dirs web \"${web_state}/current\" \"${web_state}/previous\"",
          "  prune_images \"${web_state}/current\" \"${web_state}/previous\"",
          "}",
          "",
          "case \"${action}\" in",
          "  deploy)",
          "    pull_pair \"${web}\" \"${ingress}\" || fail pull",
          "    had_current=0",
          "    if [ -f \"${web_state}/current\" ]; then",
          "      had_current=1",
          "      cp \"${web_state}/current\" \"${state}/.current-before\"",
          "    fi",
          "    if start_record \"${new_dir}/record\"; then",
          "      # 직전 current가 다른 쌍이면 rollback 대상(previous)으로 남긴다.",
          "      if [ \"${had_current}\" = 1 ] && { [ \"$(record_get \"${state}/.current-before\" web)\" != \"${web}\" ] \\",
          "        || [ \"$(record_get \"${state}/.current-before\" ingress)\" != \"${ingress}\" ]; }; then",
          "        record_put \"${web_state}/previous\" \"${state}/.current-before\"",
          "      fi",
          "      record_put \"${web_state}/current\" \"${new_dir}/record\"",
          "      rm -f \"${state}/.current-before\"",
          "      finish_records",
          "      say \"RESULT=succeeded action=deploy web=${web} ingress=${ingress}\"",
          "      exit 0",
          "    fi",
          "    # 새 쌍이 health·내부 smoke를 통과하지 못했다: 직전 current의 기록된 조각으로 되돌리고, 없으면(첫 배포) 점검 mode.",
          "    if [ \"${had_current}\" = 1 ] && start_record \"${state}/.current-before\"; then",
          "      rm -f \"${state}/.current-before\"",
          "      rm -rf \"${new_dir}\"",
          "      fail rolled-back-to-current",
          "    fi",
          "    rm -f \"${state}/.current-before\"",
          "    enter_maintenance \"${new_dir}/record\" || fail maintenance-failed",
          "    fail entered-maintenance",
          "    ;;",
          "  rollback)",
          "    rm -rf \"${new_dir}\"",
          "    # 입력 쌍이 host의 previous와 같을 때만 되돌린다(CD가 Release 기록과 provenance로 확인한 쌍).",
          "    [ -f \"${web_state}/previous\" ] || fail no-previous 2",
          "    [ \"$(record_get \"${web_state}/previous\" web)\" = \"${web}\" ] \\",
          "      && [ \"$(record_get \"${web_state}/previous\" ingress)\" = \"${ingress}\" ] || fail previous-mismatch 2",
          "    [ -f \"${web_state}/current\" ] || fail no-current 2",
          "    pull_pair \"${web}\" \"${ingress}\" || fail pull",
          "    # previous 기록을 그대로 current로 쓴다. 옛 형식 기록(형식 표지 없음)으로 돌아가면 current도 옛 형식이고, 그동안 API",
          "    # document의 deploy·rollback은 멈춘다(옛 ingress는 private listener를 API로 보내지 않는다).",
          "    if start_record \"${web_state}/previous\"; then",
          "      record_put \"${web_state}/current\" \"${web_state}/previous\"",
          "      # 되돌린 쌍은 다시 rollback 대상이 되지 않는다. host는 그보다 이전 안전 쌍을 모르므로 previous를 비운다.",
          "      rm -f \"${web_state}/previous\"",
          "      finish_records",
          "      say \"RESULT=succeeded action=rollback web=${web} ingress=${ingress}\"",
          "      exit 0",
          "    fi",
          "    if start_record \"${web_state}/current\"; then fail rollback-failed-kept-current; fi",
          "    enter_maintenance \"${web_state}/current\" || fail maintenance-failed",
          "    fail entered-maintenance",
          "    ;;",
          "  maintenance)",
          "    pull_pair \"${web}\" \"${ingress}\" || fail pull",
          "    enter_maintenance \"${new_dir}/record\" || fail maintenance-failed",
          "    say \"RESULT=succeeded action=maintenance ingress=${ingress}\"",
          "    exit 0",
          "    ;;",
          "esac"
        ]
      }
    }
  ]
}
