{
  "schemaVersion": "2.2",
  "description": "dormduri API bundle deploy: deploy, rollback or maintenance with an API digest pair. No free-form commands.",
  "parameters": {
    "action": {
      "type": "String",
      "description": "deploy | rollback | maintenance",
      "interpolationType": "ENV_VAR",
      "allowedValues": [
        "deploy",
        "rollback",
        "maintenance"
      ]
    },
    "apiDigest": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^sha256:[a-f0-9]{64}$",
      "description": "dormduri/api image digest (sha256:...)"
    },
    "apiMigrateDigest": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^sha256:[a-f0-9]{64}$",
      "description": "dormduri/api-migrate image digest (sha256:...)"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "deploy",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "900",
        "runCommand": [
          "#!/usr/bin/env bash",
          "# dormduri-api-deploy 본문(API 묶음: api·migrate one-off). scripts/infra/user-host/ssm-document.mjs가 이 파일, web 묶음",
          "# document와 같은 ../../ssm/lib.sh, ../compose.yml(API 묶음 조각), secret_bundle.py, secret-mount contract로 SSM Command",
          "# document(dormduri-api-deploy.json)를 만든다. 파라미터는 interpolationType ENV_VAR로 SSM_action·SSM_apiDigest·",
          "# SSM_apiMigrateDigest 환경 변수로만 받는다. 임의 명령을 받지 않는다.",
          "# 표준 출력은 SSM 결과로 deploy role에 보이므로 RESULT·단계 줄과 digest만 쓴다. registry 주소·compose 출력은 root 전용",
          "# host log(/opt/dormduri/state/deploy-api.log)에만 남긴다. secret 값은 어디에도 쓰지 않는다(Secrets Manager → pipe → 0400 파일).",
          "# 순서(D-AB12): lock → secret 꺼내기·설치 → migrate·grant·role smoke·auth mail outbox 확인(one-off) → 옛 API 정지 →",
          "# 새 API 시작 → readiness → host 안 smoke → current 갱신. rollout 전 실패면 rollout하지 않는다. rollout 뒤 실패면 직전",
          "# API 묶음으로 되돌리고(migration은 되돌리지 않음), 직전이 없으면 API를 내린 채 둔다(private listener는 JSON 503).",
          "# 종료 코드: 0 성공, 1 실패(rollout 없음·되돌림·API 내림), 2 입력·상태 거부, 75 다른 배포가 실행 중(host lock).",
          "set -euo pipefail",
          "umask 022",
          "export HOME=/root",
          "export AWS_SHARED_CREDENTIALS_FILE=/root/.aws/credentials",
          "export AWS_REGION=ap-northeast-2",
          "export AWS_DEFAULT_REGION=ap-northeast-2",
          "export PATH=/snap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
          "",
          "base=/opt/dormduri",
          "state=${base}/state",
          "log=${state}/deploy-api.log",
          "project=dormduri-web",
          "document_name=dormduri-api-deploy",
          "document_source=d84a2cc7485915ae009ea47b68db24af38c5fd9333d1a4fc2b3b611b9f64abbc",
          "digest_re='^sha256:[a-f0-9]{64}$'",
          "",
          "action=${SSM_action:-}",
          "api=${SSM_apiDigest:-}",
          "api_migrate=${SSM_apiMigrateDigest:-}",
          "case \"${action}\" in deploy | rollback | maintenance) ;; *)",
          "  echo \"RESULT=rejected reason=action\"",
          "  exit 2",
          "  ;;",
          "esac",
          "if ! [[ ${api} =~ ${digest_re} && ${api_migrate} =~ ${digest_re} ]]; then",
          "  echo \"RESULT=rejected reason=digest\"",
          "  exit 2",
          "fi",
          "",
          "# host lock: web document와 같은 lock이라 두 묶음의 배포가 겹치지 않는다.",
          "install -d -m 0700 \"${state}\"",
          "exec 9>\"${state}/lock\"",
          "if ! flock -n 9; then",
          "  echo \"RESULT=locked action=${action}\"",
          "  exit 75",
          "fi",
          "",
          "# user host 배포 document 공통 함수. scripts/infra/user-host/ssm-document.mjs가 이 파일을 두 document(web 묶음",
          "# deploy.sh, API 묶음 ../api/ssm/deploy-api.sh)의 `#__USER_HOST_LIB__` 자리에 그대로 넣는다. 혼자 실행하지 않는다.",
          "# 부르는 쪽이 정하는 값: action, log, state, base, project, document_name, document_source.",
          "#",
          "# release 묶음(D-AB11): web 묶음(web·ingress)과 API 묶음(api·migrate one-off)은 같은 compose project의 조각 둘이다.",
          "# 묶음마다 host 상태 `current`·`previous`는 release 기록(key=value 줄)이다.",
          "#   recordFormat=2              이 형식을 쓴 document가 남긴 기록(옛 web document가 쓴 기록에는 없다)",
          "#   release=<id>                release 이름(release 기록 디렉터리 이름)",
          "#   <image 이름>=sha256:...      service image digest 표(web 묶음: web·ingress, API 묶음: api·api-migrate)",
          "#   fragment=<절대 경로>         그 release를 띄운 compose 조각 사본",
          "#   secretRelease=<id>          (API 묶음) runtime secret release",
          "#   document=<이름>, documentSource=<sha256>  그 release를 띄운 document와 원본 hash",
          "# compose는 두 묶음의 조각을 함께 넘기고(자기 묶음은 이번 조각, 다른 묶음은 기록된 `current` 조각) 자기 묶음 service만",
          "# `up`·`stop`·`rm`한다. project 전체 `down`은 쓰지 않는다. `--remove-orphans`는 두 조각을 다 넘긴 `up`에서만 쓴다.",
          "",
          "digest_re='^sha256:[a-f0-9]{64}$'",
          "releases=${base}/releases",
          "web_state=${state}",
          "api_state=${state}/api",
          "api_transit_name=dormduri-api-transit",
          "api_transit_subnet=10.217.11.0/28",
          "api_transit_range=10.217.11.8/29",
          "api_transit_gateway=10.217.11.1",
          "web_fragment=''",
          "api_fragment=''",
          "",
          "say() {",
          "  local line",
          "  line=\"$(date -u +%Y-%m-%dT%H:%M:%SZ) $*\"",
          "  printf '%s\\n' \"${line}\"",
          "  printf '%s\\n' \"${line}\" >>\"${log}\"",
          "}",
          "fail() {",
          "  say \"RESULT=failed action=${action} reason=$1\"",
          "  exit \"${2:-1}\"",
          "}",
          "",
          "# host log는 5MiB를 넘으면 한 번 돌린다(root 전용, 바깥으로 보내지 않음).",
          "rotate_log() {",
          "  if [ -f \"${log}\" ] && [ \"$(stat -c %s \"${log}\")\" -gt 5242880 ]; then mv -f \"${log}\" \"${log}.1\"; fi",
          "}",
          "",
          "record_get() {",
          "  [ -f \"$1\" ] || return 1",
          "  sed -n \"s/^$2=//p\" \"$1\" | tail -n 1",
          "}",
          "record_is_current_format() {",
          "  [ -f \"$1\" ] && grep -qx 'recordFormat=2' \"$1\"",
          "}",
          "# 기록 파일을 원자적으로 바꾼다(같은 디렉터리의 임시 파일 → mv).",
          "record_put() {",
          "  cat \"$2\" >\"$1.tmp\"",
          "  mv \"$1.tmp\" \"$1\"",
          "}",
          "",
          "# registry login(host credential, ECR). 주소는 host log에만 남는다.",
          "registry_init() {",
          "  local account",
          "  account=$(aws sts get-caller-identity --query Account --output text 2>>\"${log}\") || fail sts",
          "  registry=\"${account}.dkr.ecr.${AWS_REGION}.amazonaws.com\"",
          "  trap registry_cleanup EXIT",
          "}",
          "registry_cleanup() {",
          "  docker logout \"${registry}\" >/dev/null 2>&1 || true",
          "  if [ -n \"${cleanup_hook:-}\" ]; then \"${cleanup_hook}\" || true; fi",
          "}",
          "registry_login() {",
          "  aws ecr get-login-password 2>>\"${log}\" | docker login --username AWS --password-stdin \"${registry}\" >>\"${log}\" 2>&1",
          "}",
          "ref() { printf '%s/dormduri/%s@%s' \"${registry}\" \"$1\" \"$2\"; }",
          "",
          "# 묶음을 건너는 API transit network. 없을 때만 고정 subnet으로 만들고, 있으면 subnet이 같은지만 본다.",
          "ensure_api_transit() {",
          "  local inspected subnet",
          "  if inspected=$(docker network inspect \"${api_transit_name}\" 2>>\"${log}\"); then",
          "    subnet=$(printf '%s' \"${inspected}\" | python3 -c '",
          "import json, sys",
          "networks = json.load(sys.stdin)",
          "print(\" \".join(item.get(\"Subnet\", \"\") for net in networks for item in (net.get(\"IPAM\", {}).get(\"Config\") or [])))",
          "') || fail network-mismatch 2",
          "    [ \"${subnet}\" = \"${api_transit_subnet}\" ] || fail network-mismatch 2",
          "    return 0",
          "  fi",
          "  docker network create --driver bridge --subnet \"${api_transit_subnet}\" --ip-range \"${api_transit_range}\" \\",
          "    --gateway \"${api_transit_gateway}\" --label dormduri.user-host.network=api-transit \"${api_transit_name}\" \\",
          "    >>\"${log}\" 2>&1 || fail network-create",
          "}",
          "",
          "# 두 조각을 넘기는 compose. 조각 변수는 use_web_record·use_api_record가 정한다.",
          "run_compose() {",
          "  if [ -n \"${api_fragment}\" ]; then set -- -f \"${api_fragment}\" \"$@\"; fi",
          "  if [ -n \"${web_fragment}\" ]; then set -- -f \"${web_fragment}\" \"$@\"; fi",
          "  docker compose -p \"${project}\" \"$@\" >>\"${log}\" 2>&1",
          "}",
          "# `--remove-orphans`는 두 조각을 다 넘겼을 때만 붙인다.",
          "orphan_flag() {",
          "  if [ -n \"${web_fragment}\" ] && [ -n \"${api_fragment}\" ]; then printf '%s' --remove-orphans; fi",
          "}",
          "",
          "web_release_of() { printf 'web-%s' \"${1:7:12}\"; }",
          "",
          "# web 묶음 기록으로 compose 변수를 정한다. 기록이 없으면 web 조각을 넘기지 않는다.",
          "use_web_record() {",
          "  local web ingress fragment",
          "  if [ -z \"$1\" ] || [ ! -f \"$1\" ]; then",
          "    web_fragment=''",
          "    return 0",
          "  fi",
          "  web=$(record_get \"$1\" web)",
          "  ingress=$(record_get \"$1\" ingress)",
          "  fragment=$(record_get \"$1\" fragment)",
          "  [[ ${web} =~ ${digest_re} && ${ingress} =~ ${digest_re} ]] || return 1",
          "  [ -n \"${fragment}\" ] && [ -s \"${fragment}\" ] || return 1",
          "  web_fragment=${fragment}",
          "  export WEB_IMAGE INGRESS_IMAGE WEB_RELEASE",
          "  WEB_IMAGE=$(ref web \"${web}\")",
          "  INGRESS_IMAGE=$(ref ingress \"${ingress}\")",
          "  WEB_RELEASE=$(web_release_of \"${web}\")",
          "}",
          "",
          "# API 묶음 기록으로 compose 변수를 정한다. 기록이 없으면 API 조각을 넘기지 않는다.",
          "use_api_record() {",
          "  local api migrate fragment secret",
          "  if [ -z \"$1\" ] || [ ! -f \"$1\" ]; then",
          "    api_fragment=''",
          "    return 0",
          "  fi",
          "  api=$(record_get \"$1\" api)",
          "  migrate=$(record_get \"$1\" api-migrate)",
          "  fragment=$(record_get \"$1\" fragment)",
          "  secret=$(record_get \"$1\" secretRelease)",
          "  [[ ${api} =~ ${digest_re} && ${migrate} =~ ${digest_re} ]] || return 1",
          "  [ -n \"${fragment}\" ] && [ -s \"${fragment}\" ] && [ -n \"${secret}\" ] || return 1",
          "  api_fragment=${fragment}",
          "  export API_IMAGE API_MIGRATE_IMAGE API_SECRET_RELEASE_DIR",
          "  API_IMAGE=$(ref api \"${api}\")",
          "  API_MIGRATE_IMAGE=$(ref api-migrate \"${migrate}\")",
          "  API_SECRET_RELEASE_DIR=${base}/secrets/api/releases/${secret}",
          "}",
          "",
          "# 옛 web document가 쓴 기록(조각 줄 없음)에 그 release가 쓴 compose 사본을 조각 기록으로 붙인다(형식 표지는 붙이지 않는다).",
          "# 옛 document는 매 배포마다 같은 파일(/opt/dormduri/compose/compose.yml)에 compose를 썼고 rollback도 그 파일을 썼다.",
          "adopt_legacy_web_records() {",
          "  local name file web ingress dir legacy_compose=${base}/compose/compose.yml",
          "  for name in current previous; do",
          "    file=${web_state}/${name}",
          "    [ -f \"${file}\" ] || continue",
          "    if grep -q '^fragment=' \"${file}\"; then continue; fi",
          "    web=$(record_get \"${file}\" web)",
          "    ingress=$(record_get \"${file}\" ingress)",
          "    [[ ${web} =~ ${digest_re} && ${ingress} =~ ${digest_re} ]] || fail legacy-record 2",
          "    [ -s \"${legacy_compose}\" ] || fail legacy-compose-missing 2",
          "    dir=${releases}/web/legacy-${web:7:12}-${ingress:7:12}",
          "    install -d -m 0755 \"${dir}\"",
          "    [ -s \"${dir}/compose.yml\" ] || cp \"${legacy_compose}\" \"${dir}/compose.yml\"",
          "    { cat \"${file}\"; printf 'fragment=%s\\n' \"${dir}/compose.yml\"; } >\"${file}.tmp\"",
          "    mv \"${file}.tmp\" \"${file}\"",
          "  done",
          "}",
          "",
          "# 기록이 가리키지 않는 release 기록 디렉터리를 지운다(current·previous가 가리키는 것만 남긴다).",
          "prune_release_dirs() {",
          "  local kind=$1 keep=' ' dir fragment record",
          "  shift",
          "  for record in \"$@\"; do",
          "    fragment=$(record_get \"${record}\" fragment || true)",
          "    [ -n \"${fragment}\" ] && keep=\"${keep}$(dirname \"${fragment}\") \"",
          "  done",
          "  for dir in \"${releases}/${kind}\"/*; do",
          "    [ -d \"${dir}\" ] || continue",
          "    case \"${keep}\" in *\" ${dir} \"*) ;; *) rm -rf \"${dir}\" ;; esac",
          "  done",
          "}",
          "",
          "# 자기 묶음 repository의 image 가운데 keep 목록 밖의 것만 지운다(다른 묶음 image는 건드리지 않는다).",
          "prune_repository_images() {",
          "  local repos=$1 keep=$2",
          "  docker image ls --digests --format json | KEEP=\"${keep}\" REG=\"${registry}\" REPOS=\"${repos}\" python3 -c '",
          "import json, os, sys",
          "keep = set(os.environ[\"KEEP\"].split())",
          "repos = {os.environ[\"REG\"] + \"/dormduri/\" + name for name in os.environ[\"REPOS\"].split()}",
          "for line in sys.stdin:",
          "    img = json.loads(line)",
          "    repo, digest = img.get(\"Repository\", \"\"), img.get(\"Digest\", \"\")",
          "    if repo in repos and digest.startswith(\"sha256:\") and repo + \"@\" + digest not in keep:",
          "        print(img[\"ID\"])",
          "' | sort -u | xargs -r docker image rm >>\"${log}\" 2>&1 || true",
          "}",
          "",
          "rotate_log",
          "say \"START action=${action} api=${api} apiMigrate=${api_migrate}\"",
          "",
          "secrets_root=${base}/secrets/api",
          "secret_releases=${secrets_root}/releases",
          "runtime_secret=/dormduri/production/api/runtime",
          "migration_secret=/dormduri/production/api/migration",
          "runtime_uid=10001",
          "tools=${api_state}/tools",
          "install -d -m 0700 \"${api_state}\" \"${tools}\" \"${base}/secrets\"",
          "install -d -m 0700 \"${secrets_root}\" \"${secret_releases}\"",
          "",
          "# web 묶음 `current`가 옛 형식(형식 표지 없음)이면 그 ingress는 private listener를 API로 보내지 않는다. deploy·rollback은",
          "# secret을 꺼내기 전에 멈추고 maintenance만 받는다. 복구는 새 형식 web 재배포 뒤 다시 실행이다. web 묶음이 점검 mode면",
          "# Web container가 내려가 있어 host 안 smoke가 늘 실패하므로(API만 쓸데없이 재시작된다) 같은 자리에서 멈춘다.",
          "web_record=${web_state}/current",
          "case \"${action}\" in",
          "  deploy | rollback)",
          "    record_is_current_format \"${web_record}\" || fail web-record-legacy 2",
          "    [ ! -e \"${base}/mode/maintenance\" ] || fail web-maintenance 2",
          "    ;;",
          "esac",
          "",
          "cat >\"${tools}/secret_bundle.py\" <<'PY'",
          "\"\"\"API secret 묶음 설치·검사(D-AB7). API 배포 document가 host에서 python3 표준 library만으로 돌린다(host에는 Node가 없다).",
          "",
          "  install <contract> <releases dir> <release id>   표준 입력의 묶음 JSON을 release 디렉터리에 key별 파일로 쓴다",
          "  verify <contract> <bundle dir>                   기존 Node 검사(infra/deploy/scripts/verify-api-secret-bundle.sh)와 같은 판정",
          "  extract <contract> <key> <file>                  표준 입력의 JSON object에서 key 하나만 있는지 보고 그 값을 0400 파일로 쓴다",
          "",
          "판정 규칙은 secret-mount contract(infra/deploy/api/secret-mount.contract.json)가 소유한다: 파일 이름 = requiredFiles,",
          "일반 파일(symlink 아님), 크기 1..maximumFileBytes, mode는 allowedFileModes, 빈 값 아님. 설치 모양은 파일 0400, 디렉터리",
          "0500, 소유는 contract의 runtimeUid:runtimeGid(root로 돌 때만 바꾼다). 값은 출력하지 않는다. 오류 문구는 고정이다.",
          "\"\"\"",
          "",
          "import json",
          "import os",
          "import stat",
          "import sys",
          "",
          "",
          "class BundleError(Exception):",
          "    pass",
          "",
          "",
          "def read_contract(path):",
          "    with open(path, encoding=\"utf-8\") as handle:",
          "        contract = json.load(handle)",
          "    names = contract.get(\"requiredFiles\")",
          "    if not isinstance(names, list) or not all(isinstance(name, str) for name in names):",
          "        raise BundleError(\"invalid secret mount contract\")",
          "    for name in names:",
          "        if not name or not all(c.isupper() or c.isdigit() or c == \"_\" for c in name) or not name[0].isupper():",
          "            raise BundleError(\"invalid secret file name\")",
          "    if not isinstance(contract.get(\"maximumFileBytes\"), int):",
          "        raise BundleError(\"invalid secret mount contract\")",
          "    return contract",
          "",
          "",
          "def read_object():",
          "    try:",
          "        value = json.load(sys.stdin)",
          "    except ValueError:",
          "        raise BundleError(\"secret bundle is not JSON\") from None",
          "    if not isinstance(value, dict):",
          "        raise BundleError(\"secret bundle is not a JSON object\")",
          "    return value",
          "",
          "",
          "def encoded_value(contract, value):",
          "    if not isinstance(value, str):",
          "        raise BundleError(\"secret bundle value is not a string\")",
          "    data = value.encode(\"utf-8\")",
          "    if len(data) < 1 or len(data) > contract[\"maximumFileBytes\"]:",
          "        raise BundleError(\"invalid secret bundle file size\")",
          "    if not value.strip():",
          "        raise BundleError(\"blank secret bundle file\")",
          "    return data",
          "",
          "",
          "def owner(contract):",
          "    if os.geteuid() != 0:",
          "        return None",
          "    return contract[\"runtimeUid\"], contract[\"runtimeGid\"]",
          "",
          "",
          "def write_file(path, data, ids):",
          "    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)",
          "    try:",
          "        os.write(fd, data)",
          "        os.fchmod(fd, 0o400)",
          "        if ids:",
          "            os.fchown(fd, ids[0], ids[1])",
          "    finally:",
          "        os.close(fd)",
          "",
          "",
          "def verify(contract, directory):",
          "    expected = sorted(contract[\"requiredFiles\"])",
          "    actual = sorted(os.listdir(directory))",
          "    if actual != expected:",
          "        raise BundleError(\"secret bundle inventory mismatch\")",
          "    for name in expected:",
          "        path = os.path.join(directory, name)",
          "        metadata = os.lstat(path)",
          "        if not stat.S_ISREG(metadata.st_mode):",
          "            raise BundleError(\"unsafe secret bundle file\")",
          "        if metadata.st_size < 1 or metadata.st_size > contract[\"maximumFileBytes\"]:",
          "            raise BundleError(\"invalid secret bundle file size\")",
          "        mode = format(stat.S_IMODE(metadata.st_mode), \"04o\")",
          "        if mode not in contract[\"allowedFileModes\"]:",
          "            raise BundleError(\"invalid secret bundle file mode\")",
          "        with open(path, \"rb\") as handle:",
          "            if not handle.read().decode(\"utf-8\", \"replace\").strip():",
          "                raise BundleError(\"blank secret bundle file\")",
          "",
          "",
          "def install(contract, releases, release):",
          "    if not release or any(not (c.isalnum() or c in \"._-\") for c in release):",
          "        raise BundleError(\"invalid release id\")",
          "    bundle = read_object()",
          "    names = sorted(contract[\"requiredFiles\"])",
          "    if sorted(bundle) != names:",
          "        raise BundleError(\"secret bundle keys differ from the contract\")",
          "    files = {name: encoded_value(contract, bundle[name]) for name in names}",
          "    destination = os.path.join(releases, release)",
          "    if os.path.lexists(destination):",
          "        raise BundleError(\"release id already exists\")",
          "    os.makedirs(releases, mode=0o700, exist_ok=True)",
          "    incoming = os.path.join(releases, \".incoming-%s-%d\" % (release, os.getpid()))",
          "    ids = owner(contract)",
          "    os.mkdir(incoming, 0o700)",
          "    try:",
          "        for name, data in files.items():",
          "            write_file(os.path.join(incoming, name), data, ids)",
          "        verify(contract, incoming)",
          "        os.chmod(incoming, 0o500)",
          "        if ids:",
          "            os.chown(incoming, ids[0], ids[1])",
          "        os.rename(incoming, destination)",
          "    except BaseException:",
          "        for name in os.listdir(incoming) if os.path.isdir(incoming) else []:",
          "            os.unlink(os.path.join(incoming, name))",
          "        if os.path.isdir(incoming):",
          "            os.rmdir(incoming)",
          "        raise",
          "",
          "",
          "def extract(contract, key, path):",
          "    bundle = read_object()",
          "    if sorted(bundle) != [key]:",
          "        raise BundleError(\"secret bundle keys differ from the expected key\")",
          "    write_file(path, encoded_value(contract, bundle[key]), owner(contract))",
          "",
          "",
          "def main(argv):",
          "    try:",
          "        if len(argv) == 5 and argv[1] == \"install\":",
          "            install(read_contract(argv[2]), argv[3], argv[4])",
          "        elif len(argv) == 4 and argv[1] == \"verify\":",
          "            verify(read_contract(argv[2]), argv[3])",
          "        elif len(argv) == 5 and argv[1] == \"extract\":",
          "            extract(read_contract(argv[2]), argv[3], argv[4])",
          "        else:",
          "            print(\"usage: secret_bundle.py install|verify|extract ...\", file=sys.stderr)",
          "            return 64",
          "    except BundleError as error:",
          "        print(str(error), file=sys.stderr)",
          "        return 65",
          "    except OSError as error:",
          "        print(\"secret bundle file error: %s\" % error.strerror, file=sys.stderr)",
          "        return 66",
          "    return 0",
          "",
          "",
          "if __name__ == \"__main__\":",
          "    sys.exit(main(sys.argv))",
