# Lightsail production runtime inputs. Do not add secret values or AWS credentials here.
NODE_ENV=production
PORT=4000
SECRET_SOURCE=mounted-files
SECRET_MOUNT_DIRECTORY=/run/secrets/dormduri-api
API_SECRET_HOST_CURRENT=/var/lib/dormduri/secrets/api/current

# The remaining non-secret runtime keys follow .env.api.example.
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_ADAPTER_CONNECT_TIMEOUT_MS=5000
DATABASE_ADAPTER_IDLE_TIMEOUT_MS=300000
EMAIL_PROVIDER=ses
SES_REGION=ap-northeast-2
SES_FROM_EMAIL=no-reply@example.com
SES_FROM_NAME=KNU Roommate
# Keep forwarding inactive until the explicit ingress peer profile is supplied.
HTTP_TRUST_PROXY_HOPS=0
HTTP_TRUST_PROXY_CIDRS=
HTTP_CORS_ALLOWED_ORIGINS=https://app.example.com
TZ=Asia/Seoul
LOG_LEVEL=info
LOG_PRETTY=false
OBSERVABILITY_SERVICE_NAME=api
CHAT_REALTIME_ALLOWED_ORIGINS=https://app.example.com
CHAT_REALTIME_TRUST_PROXY=false
LIFECYCLE_SWEEP_ENABLED=true
