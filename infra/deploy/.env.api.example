# Copy to infra/deploy/.env.api. Do not commit real values.
NODE_ENV=production
PORT=4000

# Managed PostgreSQL / RDS endpoints. Do not define a compose DB service for production.
DATABASE_URL=postgresql://app_user:REPLACE_ME@rds-private-endpoint:5432/knu_roommate?schema=public
DIRECT_URL=postgresql://migration_user:REPLACE_ME@rds-private-endpoint:5432/knu_roommate?schema=public
MIGRATION_DATABASE_URL=postgresql://migration_user:REPLACE_ME@rds-private-endpoint:5432/knu_roommate?schema=public
RETENTION_WORKER_DATABASE_URL=postgresql://retention_worker:REPLACE_ME@rds-private-endpoint:5432/knu_roommate?schema=public
RETENTION_DISCLOSURE_DATABASE_URL=postgresql://retention_disclosure:REPLACE_ME@rds-private-endpoint:5432/knu_roommate?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_ADAPTER_CONNECT_TIMEOUT_MS=5000
DATABASE_ADAPTER_IDLE_TIMEOUT_MS=300000

# Secret source. Direct env injection is supported; Secrets Manager materialization is selected explicitly when available.
# When SECRET_SOURCE=aws-secrets-manager in production, set SECRET_NAME_PREFIX to the namespace used below.
SECRET_SOURCE=env
SECRET_NAME_PREFIX=/knu-roommate/production/api

# Required production secrets. Replace placeholders in the private .env.api file only.
LOG_HASH_SECRET=REPLACE_WITH_32_BYTE_RANDOM_VALUE
RETENTION_IDENTITY_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_RANDOM_BASE64_VALUE
RETENTION_VAULT_CHAT_BODY_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_RANDOM_BASE64_VALUE
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=REPLACE_WITH_RANDOM_METRICS_TOKEN
VERIFICATION_CODE_HMAC_SECRET=REPLACE_WITH_RANDOM_AUTH_HMAC_SECRET
AUTH_LOGIN_BURST_LIMIT=30
AUTH_LOGIN_BURST_WINDOW_SECONDS=60
AUTH_LOGIN_SUSTAINED_LIMIT=120
AUTH_LOGIN_SUSTAINED_WINDOW_SECONDS=600
ROOMMATE_SEARCH_CURSOR_HMAC_SECRET=REPLACE_WITH_RANDOM_CURSOR_HMAC_SECRET
PROFILE_DETAIL_ENTRY_TOKEN_HMAC_SECRET=REPLACE_WITH_RANDOM_PROFILE_TOKEN_HMAC_SECRET
CHAT_THREAD_LIST_CURSOR_HMAC_SECRET=REPLACE_WITH_RANDOM_CHAT_CURSOR_HMAC_SECRET

# Production email provider. Sender identity must be verified before real user delivery.
EMAIL_PROVIDER=ses
SES_REGION=REPLACE_WITH_AWS_REGION
SES_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER
SES_FROM_NAME=KNU Roommate
SES_REPLY_TO_EMAIL=support@example.com
SES_CONFIGURATION_SET=

# HTTP REST ingress / cookie policy. REST CORS uses this explicit allowlist only.
# Realtime Socket.IO has separate CHAT_REALTIME_* origin/proxy policy below.
HTTP_TRUST_PROXY_HOPS=1
# HTTP_TRUST_PROXY_CIDRS=10.0.0.0/8
HTTP_CORS_ALLOWED_ORIGINS=https://app.example.com
HTTP_COOKIE_SECURE=true
HTTP_COOKIE_SAME_SITE=lax
HTTP_COOKIE_DOMAIN=.example.com

# Runtime defaults.
TZ=Asia/Seoul
LOG_LEVEL=info
LOG_PRETTY=false
OBSERVABILITY_SERVICE_NAME=api
CHAT_REALTIME_ALLOWED_ORIGINS=https://app.example.com
CHAT_REALTIME_TRUST_PROXY=true
LIFECYCLE_SWEEP_ENABLED=true

# Compose knobs. Compose interpolation reads shell env or infra/deploy/.env.
# The base compose is HTTP-only for local/proxy-behind-LB smoke. Direct nginx TLS
# termination uses nginx/examples/api.tls.conf with private cert volume overrides.
API_IMAGE_TAG=local
NGINX_HTTP_BIND=127.0.0.1
NGINX_HTTP_PORT=8080
NGINX_SERVER_NAME=api.example.com
NGINX_HTTPS_PORT=443
NGINX_TLS_CERT_PATH=/etc/letsencrypt/live/api.example.com/fullchain.pem
NGINX_TLS_KEY_PATH=/etc/letsencrypt/live/api.example.com/privkey.pem
OBSERVABILITY_NETWORK=knu-roommate-observability
