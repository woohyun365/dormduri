{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullUserHostRepositories",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": [
        "arn:aws:ecr:ap-northeast-2:<ACCOUNT_ID>:repository/dormduri/web",
        "arn:aws:ecr:ap-northeast-2:<ACCOUNT_ID>:repository/dormduri/ingress",
        "arn:aws:ecr:ap-northeast-2:<ACCOUNT_ID>:repository/dormduri/api",
        "arn:aws:ecr:ap-northeast-2:<ACCOUNT_ID>:repository/dormduri/api-migrate",
        "arn:aws:ecr:ap-northeast-2:<ACCOUNT_ID>:repository/dormduri/observability-config"
      ]
    }
  ]
}
