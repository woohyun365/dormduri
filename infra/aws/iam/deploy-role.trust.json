{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubWebCdOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::<ACCOUNT_ID>:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:woohyun365@<GITHUB_OWNER_ID>/dormduri@<GITHUB_REPO_ID>:environment:production:job_workflow_ref:woohyun365/dormduri/.github/workflows/web-cd.yml@refs/heads/main"
        }
      }
    }
  ]
}
