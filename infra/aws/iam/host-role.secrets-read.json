{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadUserHostBundles",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:ap-northeast-2:<ACCOUNT_ID>:secret:/dormduri/production/api/runtime-??????",
        "arn:aws:secretsmanager:ap-northeast-2:<ACCOUNT_ID>:secret:/dormduri/production/api/migration-??????",
        "arn:aws:secretsmanager:ap-northeast-2:<ACCOUNT_ID>:secret:/dormduri/production/observability-??????"
      ]
    }
  ]
}
