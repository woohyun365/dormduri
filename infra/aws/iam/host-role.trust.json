{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SsmHybridActivation",
      "Effect": "Allow",
      "Principal": {
        "Service": "ssm.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "<ACCOUNT_ID>"
        },
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:*"
        }
      }
    }
  ]
}
