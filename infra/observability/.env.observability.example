# Copy to infra/observability/.env.observability for local/staging rehearsal.
# Do not commit the copied file or real secret values.

OBSERVABILITY_ENV=local
OBSERVABILITY_NETWORK=knu-roommate-observability
OBSERVABILITY_TZ=KST-9

# API must run with the same METRICS_BEARER_TOKEN value when NODE_ENV=production
# or when you want local scraping to exercise the bearer guard.
API_METRICS_TARGET=host.docker.internal:4000
API_METRICS_SCHEME=http
API_METRICS_BEARER_TOKEN_FILE=./prometheus/secrets/api-metrics-bearer-token.local

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
GF_DATE_FORMATS_DEFAULT_TIMEZONE=Asia/Seoul
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_PORT=12345
ALERTMANAGER_PORT=9093
PROMETHEUS_RETENTION=15d
ALERTMANAGER_RETENTION=120h

# Web local constrained rehearsal. The upstream fixture is internal-only.
WEB_REHEARSAL_PORT=3300
WEB_REHEARSAL_RELEASE=local-rehearsal
WEB_IMAGE_TAG=local-rehearsal
WEB_UPSTREAM_IMAGE=node:24.22.0-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f

# Slack alert delivery is disabled in the committed example.
# Copy this file to .env.observability and set a real webhook URL only in the ignored local file.
SLACK_ALERTMANAGER_ENABLED=false
SLACK_ALERT_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=#knu-roommate-alerts
