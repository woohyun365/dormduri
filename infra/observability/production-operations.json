{
  "version": 1,
  "topology": {
    "initialHost": "dedicated-single-tenant-vps",
    "operatorAccess": "loopback-via-ssh-tunnel",
    "publicPortsAllowed": false
  },
  "retention": {
    "prometheus": "15d",
    "loki": "720h",
    "alertmanager": "120h"
  },
  "hostAlerts": {
    "diskUsedWarningPercent": 80,
    "diskUsedCriticalPercent": 90,
    "inodeUsedWarningPercent": 80,
    "inodeUsedCriticalPercent": 90,
    "owner": "host-or-provider-monitoring"
  },
  "volumes": [
    { "name": "prometheus-data", "classification": "rebuildable-operational-metrics" },
    { "name": "loki-data", "classification": "rebuildable-operational-logs" },
    { "name": "alloy-data", "classification": "rebuildable-collector-position" },
    { "name": "grafana-data", "classification": "rebuildable-from-git-provisioning" },
    { "name": "alertmanager-data", "classification": "operational-silence-state" }
  ],
  "alloyDockerSocket": {
    "allowedOnInitialHost": true,
    "readOnlyMountIsNotAuthorizationBoundary": true,
    "requiredContainerUser": "0:473",
    "serviceAllowlist": ["api", "nginx", "web"],
    "removalTriggers": [
      "mixed-trust-workloads",
      "multi-tenant-host",
      "collector-supply-chain-risk",
      "security-incident"
    ]
  }
}
