global:
  resolve_timeout: 5m

route:
  receiver: slack-alerts
  group_by:
    - alertname
    - service
    - severity
    - env
  group_wait: 15s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: slack-alerts
      matchers:
        - severity="critical"
      repeat_interval: 1h
    - receiver: slack-alerts
      matchers:
        - severity="warning"
      repeat_interval: 4h
    - receiver: slack-alerts
      matchers:
        - severity="info"
      repeat_interval: 24h

receivers:
  - name: slack-alerts
    slack_configs:
      - api_url: '__SLACK_ALERT_WEBHOOK_URL__'
        channel: '__SLACK_ALERT_CHANNEL__'
        username: 'KNU Roommate Alerts'
        icon_emoji: ':rotating_light:'
        send_resolved: true
        title: '{{ template "knu.slack.title" . }}'
        text: '{{ template "knu.slack.text" . }}'
        footer: 'KNU Roommate observability · __OBSERVABILITY_ENV__'

templates:
  - /etc/alertmanager/templates/*.tmpl
