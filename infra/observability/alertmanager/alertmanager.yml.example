# Example only. Do not put a real Slack webhook URL in this committed file.
# The compose service renders alertmanager.yml.template from .env.observability at runtime.
global:
  resolve_timeout: 5m

route:
  receiver: noop
  group_by: [alertname, service, severity, env]
  group_wait: 15s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: noop
