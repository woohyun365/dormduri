// 돔두리 log 처리 module(production-api-baseline D-AB15, docs/policies/operational-observability.md OO-R1). config.alloy와
// fixture 시험 설정(scripts/observability/production/alloy-pipeline.mjs)이 같은 파일을 /etc/alloy/pipeline.alloy로 import한다.
// - ingress 접속 log 행(새 형식, 그리고 원본 IP·query string·referer가 남은 옛 형식)은 새 형식 한 줄로 다시 쓴다. IP는 IPv4 /24·
//   IPv6 /48, 요청 경로는 query string을 떼고 경로 속 식별자(숫자뿐인 조각, 24자 이상 영숫자 token·UUID·cuid, `@`가 든 조각)를
//   `:id`로 바꾸고, referer는 버린다. request id는 API와 같은 형식(`[A-Za-z0-9._:-]{8,128}`)만 남기고 나머지는 `-`다(Owner
//   2026-11-11). user agent·상태·요청 시각은 그대로다.
// - ingress의 접속 log 형식이 아닌 줄(error log alert 이상)은 `, client:` 뒤 요청 문맥, query string, URL 칸을 지운다(Owner 2026-11-11).
// - 모든 service 행은 마지막에 IPv4·IPv6 원본 pattern을 한 번 더 가린다(이중 방어). 영숫자·`_`·`.`·`/`·`:` 바로 뒤의 숫자 묶음은
//   version 표기(`Chrome/130.0.0.0`)·시각으로 보고 건드리지 않는다.
// label은 service·env·container·level만 남긴다. requestId·경로·사용자 값은 label이 아니다.
declare "log_pipeline" {
  argument "forward_to" {
    comment = "가린 행을 받을 Loki receiver 목록"
  }

  loki.process "logs" {
    stage.match {
      selector = "{service=\"ingress\"}"

      // 새 형식: `<가린 IP> - [시각] "METHOD 경로 PROTOCOL" 상태 byte "UA" "request id"`. 옛 형식은 IP 뒤 remote user 칸과
      // 상태 뒤 referer 칸이 더 있다.
      stage.regex {
        expression = `^(?P<client>\S+) - (?:\S+ )?\[(?P<time>[^\]]*)\] "(?P<method>[A-Z]{1,16}) (?P<target>\S*) (?P<protocol>HTTP/[0-9.]{1,3})" (?P<status>[0-9]{3}) (?P<bytes>[0-9]+|-)(?: "(?:[^"\\]|\\.)*")? "(?P<agent>(?:[^"\\]|\\.)*)" "(?P<request_id>(?:[^"\\]|\\.)*)"$`
      }

      stage.template {
        source   = "client"
        template = `{{- $c := .Value -}}
{{- $c = regexReplaceAll "^([0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3})[.][0-9]{1,3}$" $c "${1}.0/24" -}}
{{- $c = regexReplaceAll "^::[fF]{4}:([0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3})[.][0-9]{1,3}$" $c "${1}.0/24" -}}
{{- $c = regexReplaceAll "^([0-9a-fA-F]{1,4}:[0-9a-fA-F]{1,4}:[0-9a-fA-F]{1,4}):.*$" $c "${1}::/48" -}}
{{- $c = regexReplaceAll "^([0-9a-fA-F]{1,4}(?::[0-9a-fA-F]{1,4})?)::.*$" $c "${1}::/48" -}}
{{- $c = regexReplaceAll "^::(?:[0-9a-fA-F:]*)$" $c "::/48" -}}
{{- if regexMatch "^([0-9]{1,3}[.]){3}0/24$|^([0-9a-fA-F]{1,4}(:[0-9a-fA-F]{1,4}){0,2})?::/48$" $c }}{{ $c }}{{ else }}-{{ end -}}`
      }

      stage.template {
        source   = "path"
        template = `{{- $p := regexReplaceAll "[?#].*$" .target "" -}}
{{- $p = regexReplaceAll "(^|/)[^/]*@[^/]*" $p "${1}:id" -}}
{{- $p = regexReplaceAll "(^|/)(?:[0-9]+|[A-Za-z0-9_-]{24,})(/|$)" $p "${1}:id${2}" -}}
{{- $p = regexReplaceAll "(^|/)(?:[0-9]+|[A-Za-z0-9_-]{24,})(/|$)" $p "${1}:id${2}" -}}
{{- if $p }}{{ $p }}{{ else }}-{{ end -}}`
      }

      stage.template {
        source   = "request_id"
        template = `{{- if regexMatch "^[A-Za-z0-9._:-]{8,128}$" .Value }}{{ .Value }}{{ else }}-{{ end -}}`
      }

      stage.template {
        source   = "line"
        template = `{{- if .status -}}
{{ .client }} - [{{ .time }}] "{{ .method }} {{ .path }} {{ .protocol }}" {{ .status }} {{ .bytes }} "{{ .agent }}" "{{ .request_id }}"
{{- else -}}
{{- $l := regexReplaceAll ", client: .*$" .Entry "" -}}
{{- $l = regexReplaceAll "[?][^ \"]*" $l "" -}}
{{- $l = regexReplaceAll "\"[A-Za-z][A-Za-z0-9+.-]*://[^\"]*\"" $l "\"-\"" -}}
{{ $l }}
{{- end -}}`
      }

      stage.output {
        source = "line"
      }
    }

    // 모든 service: IPv4-mapped, IPv4, IPv6(앞 hextet 셋 이상, `::` 앞 hextet 둘 이하) 순서로 가린다. 뒤 문자는 소비하지 않아
    // 쉼표로 붙은 목록도 한 번에 가린다. 이미 가린 값(`1.2.3.0/24`, `2001:db8:1::/48`)은 같은 값으로 남는다.
    stage.template {
      source   = "masked"
      template = `{{- $l := .Entry -}}
{{- $l = regexReplaceAll "(^|[^0-9A-Za-z_./:])::[fF]{4}:([0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3})[.][0-9]{1,3}" $l "${1}${2}.0/24" -}}
{{- $l = regexReplaceAll "(^|[^0-9A-Za-z_./:])([0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3})[.][0-9]{1,3}(?:/[0-9]{1,2})?" $l "${1}${2}.0/24" -}}
{{- $l = regexReplaceAll "(^|[^0-9A-Za-z_./:])([0-9a-fA-F]{1,4}:[0-9a-fA-F]{1,4}:[0-9a-fA-F]{1,4}):[0-9a-fA-F:]*(?:/[0-9]{1,3})?" $l "${1}${2}::/48" -}}
{{- $l = regexReplaceAll "(^|[^0-9A-Za-z_./:])((?:[0-9a-fA-F]{1,4}:){1,2}|:):(?:[0-9a-fA-F]{1,4}(?::[0-9a-fA-F]{1,4})*)?(?:/[0-9]{1,3})?" $l "${1}${2}:/48" -}}
{{ $l }}`
    }

    stage.output {
      source = "masked"
    }

    stage.json {
      expressions = {
        level = "level",
      }
    }

    stage.labels {
      values = {
        level = "level",
      }
    }

    stage.label_keep {
      values = ["service", "env", "container", "level"]
    }

    forward_to = argument.forward_to.value
  }

  export "receiver" {
    value = loki.process.logs.receiver
  }
}
