{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knu-roommate.invalid/schemas/local-artifact-manifest.schema.json",
  "title": "KNU Roommate local release artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "release", "builtAt", "workingTreeDirty", "images"],
  "properties": {
    "version": { "const": 1 },
    "release": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "builtAt": { "type": "string", "format": "date-time" },
    "workingTreeDirty": { "type": "boolean" },
    "builder": { "type": "string" },
    "images": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "tag", "digest", "dockerfile", "runtimeUser", "sbom", "provenance"],
        "properties": {
          "name": { "enum": ["api", "web"] },
          "tag": { "type": "string" },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "dockerfile": { "type": "string" },
          "runtimeUser": { "type": "string", "minLength": 1, "not": { "enum": ["0", "root"] } },
          "sbom": { "type": "string" },
          "provenance": { "type": "string" }
        }
      }
    }
  }
}
