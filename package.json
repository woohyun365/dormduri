{
  "name": "knu-roommate",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "shared:build": "pnpm --dir packages/shared build",
    "shared:lint": "pnpm --dir packages/shared lint",
    "shared:test": "pnpm --dir packages/shared test",
    "shared:test:prepared": "pnpm --dir packages/shared test:prepared",
    "shared:typecheck": "pnpm --dir packages/shared exec tsc --noEmit",
    "shared:typecheck:test": "pnpm --dir packages/shared typecheck:test",
    "api:prisma:generate": "pnpm --dir apps/api prisma:generate",
    "api:lint": "pnpm --dir apps/api lint",
    "api:typecheck": "pnpm --dir apps/api typecheck",
    "api:build": "pnpm --dir apps/api build",
    "api:test": "pnpm --dir apps/api test",
    "api:test:integration": "pnpm --dir apps/api test:integration",
    "web:lint": "pnpm --dir apps/web lint",
    "web:typecheck": "pnpm --dir apps/web typecheck",
    "web:test": "pnpm --dir apps/web test",
    "web:test:coverage": "pnpm --dir apps/web test:coverage",
    "web:build": "pnpm --dir apps/web build",
    "check:fast": "pnpm lint-staged && node scripts/git/workspace-layout-check.mjs",
    "typecheck": "pnpm shared:build && pnpm api:prisma:generate && pnpm shared:typecheck && pnpm shared:typecheck:test && pnpm api:typecheck:prepared && pnpm web:typecheck:prepared",
    "dev": "pnpm shared:build && pnpm -r --parallel --filter './apps/**' dev",
    "build": "pnpm shared:build && pnpm api:prisma:generate && pnpm api:build:prepared && pnpm web:build:prepared",
    "lint": "pnpm shared:build && pnpm api:prisma:generate && pnpm shared:lint && pnpm api:lint:prepared && pnpm web:lint:prepared",
    "db:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "db:push": "pnpm --dir apps/api exec prisma db push --schema prisma/schema.prisma",
    "db:seed": "pnpm --dir apps/api exec prisma db seed --schema prisma/schema.prisma",
    "db:seed:reference": "pnpm --dir apps/api prisma:seed:reference",
    "db:seed:reference:dormitories": "pnpm --dir apps/api prisma:seed:reference:dormitories",
    "db:seed:reference:colleges": "pnpm --dir apps/api prisma:seed:reference:colleges",
    "db:seed:reference:moderation": "pnpm --dir apps/api prisma:seed:reference:moderation",
    "format": "prettier . -w",
    "check": "pnpm shared:build && pnpm api:prisma:generate && pnpm api:check:prepared && pnpm web:check:prepared && prettier . -c",
    "prepare": "husky",
    "api:db:deploy:migrate": "pnpm --dir apps/api db:deploy:migrate",
    "api:db:deploy:role-grants": "pnpm --dir apps/api db:deploy:role-grants",
    "api:db:deploy:smoke": "pnpm --dir apps/api db:deploy:smoke",
    "api:db:restore-drill:smoke": "pnpm --dir apps/api db:restore-drill:smoke",
    "web:typecheck:e2e": "pnpm --dir apps/web typecheck:e2e",
    "web:e2e": "pnpm --dir apps/web e2e",
    "web:e2e:prepared": "pnpm --dir apps/web ci:e2e",
    "web:e2e:fullstack": "pnpm --dir apps/web e2e:fullstack",
    "web:storybook": "pnpm --dir apps/web storybook",
    "web:storybook:build": "pnpm --dir apps/web storybook:build",
    "web:sentry:verify-build": "node scripts/observability/sentry/check-build.mjs",
    "web:sentry:rehearsal": "node scripts/observability/rehearsal/web-sentry.mjs",
    "web:observability:rehearsal": "node scripts/observability/rehearsal/web-bff.mjs",
    "observability:check:production": "node scripts/observability/production/validate-stack.mjs",
    "infra:inspect": "node scripts/infra/check/inspect.mjs",
    "infra:check:static": "node scripts/infra/check/run.mjs --static",
    "infra:check:runtime": "node scripts/infra/check/run.mjs --runtime",
    "infra:check": "node scripts/infra/check/run.mjs",
    "infra:artifacts:build": "node scripts/infra/artifacts/build.mjs",
    "infra:artifacts:verify": "node scripts/infra/artifacts/verify-manifest.mjs",
    "infra:compose": "node scripts/infra/compose/profile.mjs",
    "infra:rehearsal:full-stack": "node scripts/infra/rehearsal/full-stack/index.mjs",
    "infra:rehearsal:lightsail-secrets": "pnpm --dir apps/api exec vitest run --config ./vitest.config.unit.ts test/operations/platform/lightsail-secret-delivery.spec.ts test/operations/platform/mounted-file-secret-reader.spec.ts",
    "codex:workflow": "node scripts/agents/codex/workflow-entry.mjs",
    "codex:completion": "node scripts/agents/codex/subagent-hook-records.mjs",
    "codex:register": "node scripts/agents/codex/task-registry.mjs register",
    "codex:accept": "node scripts/agents/codex/task-registry.mjs accept",
    "codex:release": "node scripts/agents/codex/task-registry.mjs release",
    "codex:delegate": "node scripts/agents/codex/delegate-spec.mjs",
    "codex:preflight": "node scripts/agents/codex/session-preflight.mjs --json",
    "claude:workflow": "node scripts/agents/claude/workflow-entry.mjs",
    "claude:preflight": "node scripts/agents/claude/session-preflight.mjs --json",
    "git:validate-commit-message": "node scripts/git/validate-commit-message.mjs",
    "git:branch-readiness": "node scripts/git/branch-readiness.mjs",
    "github:account:evidence": "node scripts/github/account-evidence.mjs",
    "dependency:renovate:dry-run": "node scripts/dependencies/renovate-pnpm-dry-run.mjs",
    "dependency:renovate:provider-preflight": "node scripts/dependencies/renovate-provider-preflight.mjs",
    "dependency:pnpm:cold-benchmark": "node scripts/dependencies/pnpm-cold-lockfile-benchmark.mjs",
    "security:dependabot:inventory": "node scripts/security/dependency-alert-inventory.mjs",
    "ci:performance:collect": "node scripts/ci/performance/github-actions-performance-collector.mjs",
    "ci:performance:report": "node scripts/ci/performance/github-actions-performance-report.mjs",
    "ci:performance:resources": "node scripts/ci/performance/github-actions-resource-inventory.mjs",
    "test:repo-policy": "node scripts/ci/lanes/run-repo-policy.mjs",
    "api:test:ci": "pnpm --dir apps/api test:ci",
    "api:prepare": "pnpm --dir apps/api ci:prepare",
    "api:lint:prepared": "pnpm --dir apps/api ci:lint",
    "api:typecheck:prepared": "pnpm --dir apps/api ci:typecheck",
    "api:build:prepared": "pnpm --dir apps/api ci:build",
    "api:test:runtime-config-health-contract:prepared": "pnpm --dir apps/api ci:test:runtime-config-health-contract",
    "api:test:prepared": "pnpm --dir apps/api ci:test:unit",
    "api:test:integration:prepared": "pnpm --dir apps/api ci:test:integration",
    "api:test:e2e": "pnpm --dir apps/api test:e2e",
    "api:test:e2e:prepared": "pnpm --dir apps/api ci:test:e2e",
    "api:test:stress": "pnpm --dir apps/api test:stress",
    "api:test:stress:prepared": "pnpm --dir apps/api ci:test:stress",
    "api:test:ci:prepared": "pnpm --dir apps/api ci:test",
    "api:check": "pnpm api:prepare && pnpm api:check:prepared",
    "api:check:prepared": "pnpm shared:lint && pnpm api:lint:prepared && pnpm shared:typecheck && pnpm shared:typecheck:test && pnpm api:typecheck:prepared",
    "web:prepare": "pnpm --dir apps/web ci:prepare",
    "web:lint:prepared": "pnpm --dir apps/web ci:lint",
    "web:typecheck:prepared": "pnpm --dir apps/web ci:typecheck",
    "web:test:prepared": "pnpm --dir apps/web ci:test",
    "web:test:coverage:prepared": "pnpm --dir apps/web ci:test:coverage",
    "web:build:prepared": "pnpm --dir apps/web ci:build",
    "web:check": "pnpm web:prepare && pnpm web:check:prepared",
    "web:check:prepared": "pnpm --dir apps/web ci:check",
    "infra:env:prepare": "pnpm shared:build",
    "infra:env:generate": "pnpm infra:env:prepare && pnpm --dir apps/api env:manifest:generate",
    "infra:env:check": "pnpm infra:env:prepare && pnpm --dir apps/api env:manifest:check && node scripts/infra/check/validate-env-projections.mjs",
    "claude:native": "node scripts/agents/claude/native-session.mjs",
    "scaffold": "node scripts/artifacts/scaffold.mjs",
    "plan:impact": "node scripts/agents/common/plan-impact.mjs"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-config-prettier": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "catalog:"
  }
}
