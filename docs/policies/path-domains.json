  "noDomain": [
    {
      "globs": [
        "apps/api/test/**",
        "apps/web/e2e/**",
        "apps/web/src/test/**",
        "apps/web/src/test-setup.ts",
        "apps/web/src/test-support/**",
        "apps/web/src/**/__tests__/**",
        "apps/web/src/proxy.test.ts",
        "packages/shared/test/**",
        "apps/web/type-tests/**"
      ],
      "reason": "검증 코드. 도메인은 같은 변경의 제품 code가 정한다"
    },
    {
      "globs": [
        "apps/*/tsconfig*.json",
        "apps/api/test/tsconfig.json",
        "packages/shared/tsconfig.json",
        "apps/*/eslint.config.mjs",
        "packages/shared/eslint.config.mjs",
        "apps/*/vitest.config*.ts",
        "packages/shared/vitest.config.ts",
        "apps/web/react-compiler.config.ts",
        "apps/web/playwright*.ts",
        "apps/web/postcss.config.mjs",
        "apps/api/nest-cli.json",
        "apps/api/.swcrc",
        "apps/web/.env.example",
        "apps/web/.storybook/**"
      ],
      "reason": "build·lint·test 설정"
    },
    {
      "globs": [
        "apps/*/README.md",
        "apps/web/src/screens/README.md",
        "infra/README.md",
        "infra/artifacts/**",
        "infra/rehearsal/**"
      ],
      "reason": "안내 문서·artifact schema·로컬 rehearsal 환경"
    },
    {
      "globs": [
        "apps/web/src/components/**",
        "apps/web/src/hooks/**",
        "apps/web/src/screens/ui/**",
        "apps/web/src/styles/**",
        "apps/web/public/**",
        "apps/web/src/app/layout.tsx",
        "apps/web/src/app/page.tsx",
        "apps/web/src/app/error.tsx",
        "apps/web/src/app/global-error.tsx",
        "apps/web/src/app/globals.css",
        "apps/web/src/app/metadata.ts",
        "apps/web/src/app/robots.ts",
        "apps/web/src/app/sitemap.ts"
      ],
      "reason": "도메인 밖 공통 UI·app shell"
    },
    {
      "globs": [
        "apps/api/prisma/seed.js",
        "apps/api/prisma/seed-data/fixtures/**",
        "apps/api/prisma/seeds/reference/run.js",
        "apps/api/prisma/seeds/reference/README.md"
      ],
      "reason": "개발·e2e fixture와 seed 실행 배선"
    },
    {
      "globs": ["packages/shared/src/date/**"],
      "reason": "날짜 정규화는 architecture L3 규칙이고 정책 도메인이 아니다"
    }
  ],
  "irreversiblePaths": [
    {
      "glob": "apps/api/prisma/migrations/**",
      "policy": "docs/policies/production-runtime-safety.md",
      "reason": "적용된 migration은 자동 down migration 없이 backup/PITR restore로만 되돌린다"
    },
    {
      "glob": "infra/deploy/**",
      "policy": "docs/policies/production-runtime-safety.md",
      "reason": "ingress·TLS·secret mount·image 실행 경계. 잘못 적용하면 공개 노출·운영 중단이 생긴다"
    }
  ]
}
