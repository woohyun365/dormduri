{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @repo/shared build && next build",
    "start": "next start",
    "lint": "pnpm --filter @repo/shared build && eslint",
    "test": "pnpm --filter @repo/shared build && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @repo/shared build && pnpm typecheck:product && pnpm typecheck:test && pnpm typecheck:e2e && pnpm typecheck:storybook",
    "typecheck:product": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test:coverage": "pnpm --filter @repo/shared build && vitest run --coverage",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "e2e": "playwright test",
    "e2e:fullstack": "playwright test -c playwright.fullstack.config.ts",
    "storybook": "pnpm --filter @repo/shared build && STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "storybook:build": "pnpm --filter @repo/shared build && STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json --noEmit"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "@tabler/icons-react": "^3.44.0",
    "lucide-react": "^0.456.0",
    "motion": "^12.38.0",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "jsdom": "^29.1.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/nextjs-vite": "catalog:",
    "storybook": "catalog:"
  }
}
