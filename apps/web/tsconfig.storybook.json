{
  "extends": "@repo/tsconfig/next.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "src/main/tabs/home/**/*.stories.ts",
    "src/main/tabs/home/**/*.stories.tsx",
    "src/main/tabs/home/__stories__/**/*.ts",
    "src/main/tabs/home/__stories__/**/*.tsx",
    "src/main/tabs/roommate-list/**/*.stories.ts",
    "src/main/tabs/roommate-list/**/*.stories.tsx",
    "src/main/tabs/roommate-list/__stories__/**/*.ts",
    "src/main/tabs/roommate-list/__stories__/**/*.tsx",
    "src/legal/**/*.stories.ts",
    "src/legal/**/*.stories.tsx",
    "src/legal/__stories__/**/*.ts",
    "src/legal/__stories__/**/*.tsx",
    "src/main/test-support/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "coverage", "storybook-static"]
}
