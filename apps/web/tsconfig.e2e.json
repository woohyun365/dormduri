{
  "extends": "@repo/tsconfig/playwright.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "composite": true
  },
  "include": [
    "next-env.d.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "tests/e2e/**/*.ts",
    "playwright.fullstack.config.ts"
  ],
  "exclude": ["node_modules", ".next", "coverage"]
}
