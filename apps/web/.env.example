# Public canonical host and server-only API upstream.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
API_URL=http://localhost:4000

# Provider-neutral operational events are local/test diagnostics only.
NEXT_PUBLIC_WEB_OPERATIONAL_DEBUG=0
NEXT_PUBLIC_WEB_OBSERVABILITY_ENVIRONMENT=local
NEXT_PUBLIC_WEB_RELEASE=development

# Managed browser runtime/performance telemetry. Keep disabled until the
# account-side privacy and release evidence checklist is complete.
NEXT_PUBLIC_SENTRY_ENABLED=0
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@provider.example/project-id
NEXT_PUBLIC_SENTRY_RUNTIME_ERRORS_ENABLED=1
NEXT_PUBLIC_SENTRY_PERFORMANCE_ENABLED=1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_PRIVACY_APPROVED=0
NEXT_PUBLIC_SENTRY_RELEASE_EVIDENCE_APPROVED=0

# Account-free test/rehearsal transport. Never enable in production.
NEXT_PUBLIC_SENTRY_LOCAL_RECORDING=0
# NEXT_PUBLIC_SENTRY_RECORDING_TRANSPORT_REJECT=0

# Server-side BFF structured event output. Production enables this by default.
WEB_BFF_OPERATIONAL_LOGGING_ENABLED=0
WEB_BFF_SUCCESS_SAMPLE_RATE=0.25

# Server/build-only Sentry release inputs. Never expose the auth token through
# NEXT_PUBLIC_* or a Docker build ARG.
SENTRY_SOURCE_MAP_UPLOAD_ENABLED=0
SENTRY_RELEASE_EVIDENCE_APPROVED=0
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE=<immutable-commit-sha-or-image-tag>
