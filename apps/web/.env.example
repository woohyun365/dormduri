# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API (백엔드 연동 시)
# FE에서 직접 사용하는 public API base. 현재 auth는 `/api/auth/*` BFF를 우선 사용한다.
NEXT_PUBLIC_API_URL=/api
# Next.js `/api/auth/*` BFF가 `${API_URL}/auth/*` 로 전달하므로
# 여기에는 `/api` 접두사를 붙이지 않는다.
API_URL=http://localhost:4000

# Auth (추후 설정)
# AUTH_SECRET=
# KNU_EMAIL_DOMAIN=kangwon.ac.kr
