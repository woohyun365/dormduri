# Public canonical host and server-only API upstream.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
API_URL=http://localhost:4000

# Browser operational telemetry stays disabled until a provider, privacy review,
# retention, CSP, and release smoke are approved.
NEXT_PUBLIC_WEB_OPERATIONAL_TELEMETRY_ENABLED=0
NEXT_PUBLIC_WEB_RUNTIME_ERRORS_ENABLED=1
NEXT_PUBLIC_WEB_VITALS_ENABLED=1
NEXT_PUBLIC_WEB_VITALS_CORE_SAMPLE_RATE=1
NEXT_PUBLIC_WEB_VITALS_SUPPORTING_SAMPLE_RATE=0.25
NEXT_PUBLIC_WEB_OPERATIONAL_DEBUG=0
NEXT_PUBLIC_WEB_OBSERVABILITY_ENVIRONMENT=local
NEXT_PUBLIC_WEB_RELEASE=development
# NEXT_PUBLIC_WEB_TELEMETRY_ENDPOINT=https://provider.example/intake
NEXT_PUBLIC_WEB_TELEMETRY_PRIVACY_APPROVED=0
# NEXT_PUBLIC_WEB_TELEMETRY_RETENTION_DAYS=30

# Server-side BFF structured event output. Production enables this by default.
WEB_BFF_OPERATIONAL_LOGGING_ENABLED=0
WEB_BFF_SUCCESS_SAMPLE_RATE=0.25
WEB_BROWSER_SOURCE_MAPS_ENABLED=0
