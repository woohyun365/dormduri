{
  "extends": "@repo/tsconfig/base.json",
  "compilerOptions": {
    /* ESM(Node 20 fixed semantics) */
    "module": "node20",
    "resolvePackageJsonExports": true,

    /* Nest(데코레이터) */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* 상호운용성 / 타입스크립트 사용 편의성(개발자 경험) */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    /* Runtime types */
    "types": ["jest", "node"],

    /* Output */
    "target": "ES2023",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "removeComments": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
