generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  M
  F
}

enum Campus {
  CHUNCHEON
  SAMCHEOK
  DOGYE
}

enum VerificationCodePurpose {
  SIGNUP
  RESET_PASSWORD
}

enum ModerationTermCategory {
  BLOCKED_TEXT
  RESERVED_NICKNAME
}

enum ModerationMatchMode {
  EXACT
  INCLUDES
}

enum ModerationSurface {
  ALL
  NICKNAME
  INTRO
}

enum DormitorySelectionState {
  NOT_SELECTED
  UNASSIGNED
  ASSIGNED
}

enum DormitoryGenderPolicy {
  M
  F
  BOTH
}

enum DormitoryBathroomType {
  SHARED
  PRIVATE
}

model CampusMaster {
  code         Campus              @id
  nameKo       String
  isOperated   Boolean
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  updatedAt    DateTime            @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  dormitories  Dormitory[]
  guideContent CampusGuideContent?
}

model CampusGuideContent {
  campusCode        Campus       @id
  homepageUrl       String
  commonRules       Json
  emergencyContacts Json
  createdAt         DateTime     @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  updatedAt         DateTime     @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  campus            CampusMaster @relation(fields: [campusCode], references: [code], onDelete: Cascade)
}

model Dormitory {
  id           String                @id
  campusCode   Campus
  nameKo       String
  roomType     Int
  genderPolicy DormitoryGenderPolicy
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  updatedAt    DateTime              @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  campus       CampusMaster          @relation(fields: [campusCode], references: [code], onDelete: Restrict)
  guide        DormitoryGuide?
  users        User[]

  @@index([campusCode, genderPolicy, sortOrder])
}

model DormitoryGuide {
  dormitoryId   String                @id
  bathroomType  DormitoryBathroomType
  facilities    Json
  repairContact String
  diningContact String?
  createdAt     DateTime              @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  updatedAt     DateTime              @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  dormitory     Dormitory             @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
}

model Season {
  id                String   @id @default(cuid())
  academicYear      Int
  semester          Int
  name              String
  roomSelectionDate DateTime @db.Date
  createdAt         DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  updatedAt         DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)

  @@unique([academicYear, semester])
  @@index([roomSelectionDate])
}

model User {
  id                      String                  @id @default(uuid())
  email                   String
  emailNormalized         String                  @unique
  passwordHash            String
  nickname                String
  nicknameNormalized      String                  @unique
  gender                  Gender
  campus                  Campus
  lifestyle               Json
  intro                   String                  @default("")
  dormitoryId             String?
  dormitorySelectionState DormitorySelectionState @default(NOT_SELECTED)
  emailVerifiedAt         DateTime?               @db.Timestamptz(3)
  createdAt               DateTime                @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  updatedAt               DateTime                @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  dormitory               Dormitory?              @relation(fields: [dormitoryId], references: [id], onDelete: SetNull)
  authSessions            AuthSession[]

  @@index([campus, dormitorySelectionState])
  @@index([dormitoryId])
}

model LoginAttempt {
  id              String    @id @default(uuid())
  emailNormalized String    @unique
  failureCount    Int       @default(0)
  lockedUntil     DateTime? @db.Timestamptz(3)
  lastFailedAt    DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  updatedAt       DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
}

model VerificationCode {
  id              String                  @id @default(uuid())
  emailNormalized String
  purpose         VerificationCodePurpose
  codeHash        String
  failedAttempts  Int                     @default(0)
  issuedAt        DateTime                @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  expiresAt       DateTime                @db.Timestamptz(3)
  verifiedAt      DateTime?               @db.Timestamptz(3)
  consumedAt      DateTime?               @db.Timestamptz(3)
  requestIp       String?

  @@index([emailNormalized, purpose])
}

model VerificationCodeRequestLog {
  id              String                  @id @default(uuid())
  emailNormalized String
  purpose         VerificationCodePurpose
  requestIp       String
  createdAt       DateTime                @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)

  @@index([emailNormalized, purpose, requestIp, createdAt])
  @@index([requestIp, createdAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  rememberMe       Boolean   @default(false)
  refreshTokenHash String?
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  updatedAt        DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ModerationTerm {
  id             String                 @id @default(uuid())
  term           String
  normalizedTerm String
  category       ModerationTermCategory
  matchMode      ModerationMatchMode
  surface        ModerationSurface
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  updatedAt      DateTime               @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)

  @@unique([normalizedTerm, category, matchMode, surface])
  @@index([surface, category, isActive])
}
