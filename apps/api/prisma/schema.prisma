model CampusMaster {
  code        Campus          @id
  nameKo      String
  isOperated  Boolean
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  colleges    CollegeMaster[]
  dormitories Dormitory[]
  seasons     Season[]
}

model CollegeMaster {
  code                      String                     @id
  campusCode                Campus
  nameKo                    String
  sortOrder                 Int                        @default(0)
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @default(now()) @updatedAt @db.Timestamptz(3)
  campus                    CampusMaster               @relation(fields: [campusCode], references: [code], onDelete: Restrict)
  academicIdentities        UserAcademicIdentity[]
  seasonParticipantProfiles SeasonParticipantProfile[]

  @@unique([campusCode, nameKo])
  @@index([campusCode, sortOrder])
}

model Dormitory {
  id                 String                     @id
  campusCode         Campus
  nameKo             String
  roomType           Int
  genderPolicy       DormitoryGenderPolicy
  matchingSupported  Boolean                    @default(true)
  isActive           Boolean                    @default(true)
  sortOrder          Int                        @default(0)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @default(now()) @updatedAt @db.Timestamptz(3)
  campus             CampusMaster               @relation(fields: [campusCode], references: [code], onDelete: Restrict)
  seasonOperations   SeasonDormitoryOperation[]
  seasonParticipants SeasonParticipant[]

  @@index([campusCode, isActive, matchingSupported, genderPolicy, sortOrder])
}

model Season {
  id                   String                      @id @default(cuid())
  campusCode           Campus                      @default(CHUNCHEON)
  academicYear         Int
  semester             Int
  name                 String
  preparationStartDate DateTime                    @db.Date
  matchingStartDate    DateTime                    @db.Date
  seasonEndDate        DateTime                    @db.Date
  overrideState        SeasonOverrideState?
  overrideReason       String?
  overrideStartedAt    DateTime?                   @db.Timestamptz(3)
  overrideEndsAt       DateTime?                   @db.Timestamptz(3)
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                    @default(now()) @updatedAt @db.Timestamptz(3)
  campus               CampusMaster                @relation(fields: [campusCode], references: [code], onDelete: Restrict)
  dormitoryOperations  SeasonDormitoryOperation[]
  participants         SeasonParticipant[]
  matchRequests        MatchRequest[]
  activeMatches        ActiveMatch[]
  matchHistoryEntries  SeasonMatchHistoryEntry[]
  conversationThreads  ConversationThread[]
  operationAuditEvents SeasonOperationAuditEvent[]
  userBookmarks        UserBookmark[]

  @@unique([campusCode, academicYear, semester])
  @@index([campusCode, matchingStartDate])
  @@index([campusCode, seasonEndDate])
}

model SeasonOperationAuditEvent {
  id                String                     @id @default(cuid())
  seasonId          String
  campusCode        Campus
  action            SeasonOperationAuditAction
  actorUserId       String?
  actorCapabilities Json?
  reason            String?
  previousSnapshot  Json
  nextSnapshot      Json
  metadata          Json?
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  season            Season                     @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, createdAt])
  @@index([campusCode, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

model SeasonDormitoryOperation {
  seasonId          String
  dormitoryId       String
  isOperated        Boolean   @default(true)
  roomSelectionDate DateTime  @db.Date
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  season            Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  dormitory         Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@id([seasonId, dormitoryId])
  @@index([seasonId, isOperated, roomSelectionDate])
  @@index([dormitoryId, roomSelectionDate])
}

model User {
  id                       String                                   @id @default(uuid())
  email                    String
  emailNormalized          String                                   @unique
  passwordHash             String
  gender                   Gender
  campus                   Campus
  emailVerifiedAt          DateTime?                                @db.Timestamptz(3)
  deletedAt                DateTime?                                @db.Timestamptz(3)
  createdAt                DateTime                                 @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                                 @default(now()) @updatedAt @db.Timestamptz(3)
  authSessions             AuthSession[]
  displayIdentity          UserDisplayIdentity?
  academicIdentity         UserAcademicIdentity?
  academicChangeAllowance  UserAcademicIdentityChangeAllowance?
  academicChangeEvents     UserAcademicIdentityChangeEvent[]
  dismissedNotices         UserDismissedNotice[]
  nicknameChangeEvents     UserDisplayIdentityNicknameChangeEvent[]
  seasonParticipants       SeasonParticipant[]
  receivedNotifications    UserNotification[]                       @relation("UserNotificationRecipient")
  actedNotifications       UserNotification[]                       @relation("UserNotificationActor")
  notificationOutboxEvents NotificationOutboxEvent[]
  bookmarksCreated         UserBookmark[]                           @relation("UserBookmarkViewer")
  bookmarksReceived        UserBookmark[]                           @relation("UserBookmarkTarget")
  blocksCreated            UserBlock[]                              @relation("UserBlockBlocker")
  blocksReceived           UserBlock[]                              @relation("UserBlockBlocked")
  blockEventsAuthored      UserBlockEvent[]                         @relation("UserBlockEventActor")
  blockEventsTargeted      UserBlockEvent[]                         @relation("UserBlockEventTarget")
  supportTicketsRequested  SupportTicket[]                          @relation("SupportTicketRequester")
  supportMessagesAuthored  SupportTicketMessage[]                   @relation("SupportTicketMessageSender")
  legalAcceptances         LegalAcceptanceRecord[]
}

model UserDisplayIdentity {
  userId             String    @id
  nickname           String
  nicknameNormalized String    @unique
  nicknameChangedAt  DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nickname])
}

model UserAcademicIdentity {
  userId      String        @id
  collegeCode String
  birthYear   Int
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  college     CollegeMaster @relation(fields: [collegeCode], references: [code], onDelete: Restrict)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collegeCode])
  @@index([birthYear])
}

model UserAcademicIdentityChangeAllowance {
  userId                 String                               @id
  academicYear           Int
  collegeChangeRemaining Int                                  @default(1)
  resetReason            AcademicIdentityAllowanceResetReason
  createdAt              DateTime                             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                             @default(now()) @updatedAt @db.Timestamptz(3)
  user                   User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([academicYear])
}

model UserDismissedNotice {
  userId      String
  noticeKey   String
  dismissedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, noticeKey])
  @@index([noticeKey, dismissedAt])
}

/// 삭제 계정의 제한 보존 식별 anchor. 원문 payload 보존은 `RetainedVaultObject`가 담당한다.
model RetainedIdentity {
  id                           String                                   @id @default(uuid())
  originalUserId               String?                                  @unique
  anonymizedActorKey           String                                   @unique
  displayLabel                 String
  deletedAt                    DateTime                                 @db.Timestamptz(3)
  emailHash                    String?
  encryptedIdentifierPayload   Json?
  identifierKeyVersion         String?
  retentionDisposedAt          DateTime?                                @db.Timestamptz(3)
  retentionDisposalReason      String?
  metadata                     Json?
  createdAt                    DateTime                                 @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                                 @default(now()) @updatedAt @db.Timestamptz(3)
  archiveJobs                  ArchiveJob[]
  holds                        RetainedIdentityHold[]
  accessLogs                   RetentionAccessLog[]
  nicknameChangeEvents         UserDisplayIdentityNicknameChangeEvent[]
  academicIdentityChangeEvents UserAcademicIdentityChangeEvent[]
  triggeredRetentionCases      RetentionCase[]                          @relation("RetentionCaseTriggerIdentity")
  subjectVaultObjects          RetainedVaultObject[]                    @relation("RetainedVaultObjectSubjectIdentity")

  @@index([deletedAt])
  @@index([retentionDisposedAt, deletedAt])
}

model UserDisplayIdentityNicknameChangeEvent {
  id                           String                                 @id @default(uuid())
  userId                       String
  retainedIdentityId           String?
  retainedVaultObjectId        String?                                @unique
  redactedAt                   DateTime?                              @db.Timestamptz(3)
  redactionReason              String?
  source                       DisplayIdentityNicknameChangeSource
  reason                       DisplayIdentityNicknameChangeReason
  actorType                    DisplayIdentityNicknameChangeActorType
  actorId                      String?
  previousNickname             String
  previousNicknameNormalized   String
  nextNickname                 String
  nextNicknameNormalized       String
  seasonId                     String?
  participantId                String?
  seasonProfileSnapshotUpdated Boolean                                @default(false)
  reportId                     String?
  moderationCaseId             String?
  sanctionId                   String?
  approvalReference            String?
  metadata                     Json?
  changedAt                    DateTime                               @db.Timestamptz(3)
  createdAt                    DateTime                               @default(now()) @db.Timestamptz(3)
  retainedIdentity             RetainedIdentity?                      @relation(fields: [retainedIdentityId], references: [id], onDelete: SetNull)
  retainedVaultObject          RetainedVaultObject?                   @relation("NicknameEventRetainedVaultObject", fields: [retainedVaultObjectId], references: [id], onDelete: SetNull)
  user                         User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
  @@index([source, changedAt])
  @@index([actorType, actorId, changedAt])
  @@index([retainedIdentityId, changedAt])
  @@index([retainedVaultObjectId])
  @@index([redactedAt])
  @@index([reportId])
  @@index([moderationCaseId])
  @@index([sanctionId])
}

model UserAcademicIdentityChangeEvent {
  id                    String                          @id @default(uuid())
  userId                String
  retainedIdentityId    String?
  retainedVaultObjectId String?                         @unique
  redactedAt            DateTime?                       @db.Timestamptz(3)
  redactionReason       String?
  source                AcademicIdentityChangeSource
  reason                AcademicIdentityChangeReason
  actorType             AcademicIdentityChangeActorType
  actorId               String?
  previousCollegeCode   String
  nextCollegeCode       String
  previousBirthYear     Int
  nextBirthYear         Int
  seasonId              String?
  participantId         String?
  reportId              String?
  moderationCaseId      String?
  sanctionId            String?
  approvalReference     String?
  metadata              Json?
  changedAt             DateTime                        @db.Timestamptz(3)
