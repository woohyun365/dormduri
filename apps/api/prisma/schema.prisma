  participantAId        String
  participantBId        String
  openedByParticipantId String
  threadKind            ConversationThreadKind
  activeMatchId         String?                            @unique
  status                ConversationThreadStatus           @default(OPEN)
  closedReason          ConversationThreadClosedReason?
  closedAt              DateTime?                          @db.Timestamptz(3)
  lastMessageAt         DateTime?                          @db.Timestamptz(3)
  createdAt             DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                           @default(now()) @updatedAt @db.Timestamptz(3)
  season                Season                             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  participantA          SeasonParticipant                  @relation("ConversationThreadParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB          SeasonParticipant                  @relation("ConversationThreadParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  openedByParticipant   SeasonParticipant                  @relation("ConversationThreadOpenedBy", fields: [openedByParticipantId], references: [id], onDelete: Cascade)
  activeMatch           ActiveMatch?                       @relation(fields: [activeMatchId], references: [id], onDelete: SetNull)
  members               ConversationThreadMember[]
  messages              ConversationMessage[]
  lifecycleEvents       ConversationThreadLifecycleEvent[]

  @@index([seasonId, pairKey, status])
  @@index([participantAId])
  @@index([participantBId])
}

model ConversationThreadLifecycleEvent {
  id                     String                                  @id @default(uuid())
  threadId               String
  eventType              ConversationThreadLifecycleEventType
  reason                 ConversationThreadLifecycleEventReason
  actorType              ConversationThreadLifecycleActorType    @default(SYSTEM)
  actorUserId            String?
  sourceDomain           ConversationThreadLifecycleSourceDomain
  sourceActiveMatchId    String?
  sourceMatchRequestId   String?
  sourceUnmatchRequestId String?
  sourceBlockId          String?
  sourceReportCaseId     String?
  sourceArchiveJobId     String?
  metadata               Json?
  occurredAt             DateTime                                @default(now()) @db.Timestamptz(3)
  createdAt              DateTime                                @default(now()) @db.Timestamptz(3)
  thread                 ConversationThread                      @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, occurredAt, id], map: "CTLifecycleEvent_thread_occurred_id_idx")
  @@index([eventType, occurredAt, id], map: "CTLifecycleEvent_type_occurred_id_idx")
  @@index([actorUserId, occurredAt, id], map: "CTLifecycleEvent_actor_occurred_id_idx")
  @@index([sourceDomain, occurredAt, id], map: "CTLifecycleEvent_domain_occurred_id_idx")
  @@index([sourceActiveMatchId, occurredAt, id], map: "CTLifecycleEvent_active_match_occurred_id_idx")
  @@index([sourceMatchRequestId, occurredAt, id], map: "CTLifecycleEvent_match_request_occurred_id_idx")
  @@index([sourceUnmatchRequestId, occurredAt, id], map: "CTLifecycleEvent_unmatch_request_occurred_id_idx")
  @@index([sourceBlockId, occurredAt, id], map: "CTLifecycleEvent_block_occurred_id_idx")
  @@index([sourceReportCaseId, occurredAt, id], map: "CTLifecycleEvent_report_case_occurred_id_idx")
  @@index([sourceArchiveJobId, occurredAt, id], map: "CTLifecycleEvent_archive_job_occurred_id_idx")
  @@index([createdAt], map: "CTLifecycleEvent_createdAt_idx")
}

model ConversationThreadMember {
  threadId          String
  participantId     String
  memberState       ConversationThreadMemberState @default(ACTIVE)
  leftAt            DateTime?                     @db.Timestamptz(3)
  mutedAt           DateTime?                     @db.Timestamptz(3)
  lastReadAt        DateTime?                     @db.Timestamptz(3)
  lastReadMessageId String?
  lastVisibleAt     DateTime?                     @db.Timestamptz(3)
  createdAt         DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                      @default(now()) @updatedAt @db.Timestamptz(3)
  thread            ConversationThread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  participant       SeasonParticipant             @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([threadId, participantId])
  @@index([participantId, memberState, updatedAt])
  @@index([participantId, memberState, threadId])
  @@index([participantId, lastVisibleAt])
}

model ConversationMessage {
  id                    String                              @id @default(uuid())
  threadId              String
  senderParticipantId   String
  clientMessageId       String?
  body                  String
  bodyState             ConversationMessageBodyState        @default(PLAIN)
  tombstoneReason       ConversationMessageTombstoneReason?
  tombstonedAt          DateTime?                           @db.Timestamptz(3)
  bodyRetainedAt        DateTime?                           @db.Timestamptz(3)
  bodyDisposedAt        DateTime?                           @db.Timestamptz(3)
  retainedVaultObjectId String?                             @unique
  bodyVersion           Int                                 @default(1)
  sentAt                DateTime                            @default(now()) @db.Timestamptz(3)
  deletedAt             DateTime?                           @db.Timestamptz(3)
  createdAt             DateTime                            @default(now()) @db.Timestamptz(3)
  thread                ConversationThread                  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderParticipant     SeasonParticipant                   @relation("ConversationMessageSender", fields: [senderParticipantId], references: [id], onDelete: Cascade)
  retainedVaultObject   RetainedVaultObject?                @relation("ConversationMessageRetainedVaultObject", fields: [retainedVaultObjectId], references: [id], onDelete: SetNull)

  @@unique([senderParticipantId, clientMessageId])
  @@index([threadId, sentAt])
  @@index([threadId, sentAt, id])
  @@index([senderParticipantId, sentAt])
  @@index([senderParticipantId, sentAt, id])
  @@index([bodyState, tombstonedAt])
  @@index([retainedVaultObjectId])
}

