generator client {
  provider        = "prisma-client"
  previewFeatures = ["typedSql"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  M
  F
}

enum Campus {
  CHUNCHEON
  SAMCHEOK
  DOGYE
}

enum VerificationCodePurpose {
  SIGNUP
  RESET_PASSWORD
}

enum ModerationTermCategory {
  BLOCKED_TEXT
  RESERVED_NICKNAME
}

enum ModerationMatchMode {
  EXACT
  INCLUDES
}

enum ModerationSurface {
  ALL
  NICKNAME
  INTRO
}

enum DormitorySelectionState {
  NOT_SELECTED
  UNASSIGNED
  ASSIGNED
}

enum DormitoryGenderPolicy {
  M
  F
  BOTH
}

enum DormitoryBathroomType {
  SHARED
  PRIVATE
}

enum SeasonOverrideState {
  OFF_SEASON
  SEASON_OPEN
  SEASON_MATCHING
  SEASON_POST_MATCH
}

enum SeasonParticipationIntent {
  UNDECIDED
  REGISTERED
  DECLINED
}

enum ParticipantStatus {
  NOT_STARTED
  DRAFT
  ACTIVE
  MATCHED
  WITHDRAWN
  EXPIRED
}

enum ParticipantHiddenReasonCode {
  POLICY_VIOLATION
  SAFETY_REVIEW
  ADMIN_REQUEST
  OTHER
}

model CampusMaster {
  code         Campus              @id
  nameKo       String
  isOperated   Boolean
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @db.Timestamptz(3)
  dormitories  Dormitory[]
  seasons      Season[]
  guideContent CampusGuideContent?
}

model CampusGuideContent {
  campusCode        Campus       @id
  homepageUrl       String
  commonRules       Json
  emergencyContacts Json
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @default(now()) @db.Timestamptz(3)
  campus            CampusMaster @relation(fields: [campusCode], references: [code], onDelete: Cascade)
}

model Dormitory {
  id                 String                     @id
  campusCode         Campus
  nameKo             String
  roomType           Int
  genderPolicy       DormitoryGenderPolicy
  sortOrder          Int                        @default(0)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @default(now()) @db.Timestamptz(3)
  campus             CampusMaster               @relation(fields: [campusCode], references: [code], onDelete: Restrict)
  guide              DormitoryGuide?
  seasonOperations   SeasonDormitoryOperation[]
  seasonParticipants SeasonParticipant[]
  users              User[]

  @@index([campusCode, genderPolicy, sortOrder])
}

model DormitoryGuide {
  dormitoryId   String                @id
  bathroomType  DormitoryBathroomType
  facilities    Json
  repairContact String
  diningContact String?
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @default(now()) @db.Timestamptz(3)
  dormitory     Dormitory             @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
}

model Season {
  id                   String                     @id @default(cuid())
  campusCode           Campus                     @default(CHUNCHEON)
  academicYear         Int
  semester             Int
  name                 String
  preparationStartDate DateTime                   @db.Date
  matchingStartDate    DateTime                   @db.Date
  seasonEndDate        DateTime                   @db.Date
  overrideState        SeasonOverrideState?
  overrideReason       String?
  overrideStartedAt    DateTime?                  @db.Timestamptz(3)
  overrideEndsAt       DateTime?                  @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @default(now()) @db.Timestamptz(3)
  campus               CampusMaster               @relation(fields: [campusCode], references: [code], onDelete: Restrict)
  dormitoryOperations  SeasonDormitoryOperation[]
  participants         SeasonParticipant[]

  @@unique([campusCode, academicYear, semester])
  @@index([campusCode, matchingStartDate])
  @@index([campusCode, seasonEndDate])
}

model SeasonDormitoryOperation {
  seasonId          String
  dormitoryId       String
  isOperated        Boolean   @default(true)
  roomSelectionDate DateTime  @db.Date
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @db.Timestamptz(3)
  season            Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  dormitory         Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@id([seasonId, dormitoryId])
  @@index([seasonId, isOperated, roomSelectionDate])
  @@index([dormitoryId, roomSelectionDate])
}

model User {
  id                      String                  @id @default(uuid())
  email                   String
  emailNormalized         String                  @unique
  passwordHash            String
  gender                  Gender
  campus                  Campus
  dormitoryId             String?
  dormitorySelectionState DormitorySelectionState @default(NOT_SELECTED)
  emailVerifiedAt         DateTime?               @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @default(now()) @db.Timestamptz(3)
  dormitory               Dormitory?              @relation(fields: [dormitoryId], references: [id], onDelete: SetNull)
  authSessions            AuthSession[]
  profile                 UserProfile?
  seasonParticipants      SeasonParticipant[]

  @@index([campus, dormitorySelectionState])
  @@index([dormitoryId])
}

model UserProfile {
  userId             String         @id
  nickname           String
  nicknameNormalized String         @unique
  nicknameChangedAt  DateTime?      @db.Timestamptz(3)
  lifestyle          Json
  intro              String         @default("")
  messageToRoommate  String?
  collegeCode        String?
  grade              String?
  mbti               String?
  birthYear          Int?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @default(now()) @db.Timestamptz(3)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nickname])
}

model SeasonParticipant {
  id                      String                       @id @default(uuid())
  seasonId                String
  userId                  String
  participationIntent     SeasonParticipationIntent    @default(UNDECIDED)
  registeredAt            DateTime?                    @db.Timestamptz(3)
  declinedAt              DateTime?                    @db.Timestamptz(3)
  dormitoryId             String?
  dormitorySelectionState DormitorySelectionState      @default(NOT_SELECTED)
  participantStatus       ParticipantStatus            @default(NOT_STARTED)
  campusCodeSnapshot      Campus
  genderSnapshot          Gender
  joinedAt                DateTime                     @default(now()) @db.Timestamptz(3)
  activatedAt             DateTime?                    @db.Timestamptz(3)
  matchedAt               DateTime?                    @db.Timestamptz(3)
  withdrawnAt             DateTime?                    @db.Timestamptz(3)
  expiredAt               DateTime?                    @db.Timestamptz(3)
  hiddenByAdminAt         DateTime?                    @db.Timestamptz(3)
  hiddenReasonCode        ParticipantHiddenReasonCode?
  hiddenReasonDetail      String?
  deactivatedAt           DateTime?                    @db.Timestamptz(3)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                     @default(now()) @db.Timestamptz(3)
  dormitory               Dormitory?                   @relation(fields: [dormitoryId], references: [id], onDelete: SetNull)
  season                  Season                       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user                    User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile                 SeasonParticipantProfile?

  @@unique([seasonId, userId])
  @@index([userId, seasonId])
  @@index([seasonId, dormitoryId, dormitorySelectionState])
  @@index([seasonId, participantStatus])
}

model SeasonParticipantProfile {
  participantId                      String            @id
  nicknameSnapshot                   String
  nicknameNormalizedSnapshot         String
  lifestyle                          Json
  intro                              String            @default("")
  messageToRoommate                  String?
  collegeCode                        String?
  grade                              String?
  mbti                               String?
  birthYear                          Int?
  templateSourceUserProfileUpdatedAt DateTime?         @db.Timestamptz(3)
  createdAt                          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime          @default(now()) @db.Timestamptz(3)
  participant                        SeasonParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([nicknameNormalizedSnapshot])
}

model LoginAttempt {
  id              String    @id @default(uuid())
  emailNormalized String    @unique
  failureCount    Int       @default(0)
  lockedUntil     DateTime? @db.Timestamptz(3)
  lastFailedAt    DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @db.Timestamptz(3)
}

model VerificationCode {
  id              String                  @id @default(uuid())
  emailNormalized String
  purpose         VerificationCodePurpose
  codeHash        String
  failedAttempts  Int                     @default(0)
  issuedAt        DateTime                @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime                @db.Timestamptz(3)
  verifiedAt      DateTime?               @db.Timestamptz(3)
  consumedAt      DateTime?               @db.Timestamptz(3)
  requestIp       String?

  @@index([emailNormalized, purpose])
}

model VerificationCodeRequestLog {
  id              String                  @id @default(uuid())
  emailNormalized String
  purpose         VerificationCodePurpose
  requestIp       String
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)

  @@index([emailNormalized, purpose, requestIp, createdAt])
  @@index([requestIp, createdAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  rememberMe       Boolean   @default(false)
  refreshTokenHash String?
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ModerationTerm {
  id             String                 @id @default(uuid())
  term           String
  normalizedTerm String
  category       ModerationTermCategory
  matchMode      ModerationMatchMode
  surface        ModerationSurface
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @default(now()) @db.Timestamptz(3)

  @@unique([normalizedTerm, category, matchMode, surface])
  @@index([surface, category, isActive])
}
