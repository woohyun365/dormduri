generator client {
  provider        = "prisma-client"
  previewFeatures = ["typedSql"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  M
  F
}

enum Campus {
  CHUNCHEON
  SAMCHEOK
  DOGYE
}

enum VerificationCodePurpose {
  SIGNUP
  RESET_PASSWORD
}

enum ModerationTermCategory {
  BLOCKED_TEXT
  RESERVED_NICKNAME
}

enum ModerationMatchMode {
  EXACT
  INCLUDES
}

enum ModerationSurface {
  ALL
  NICKNAME
  INTRO
}

enum DormitorySelectionState {
  NOT_SELECTED
  UNASSIGNED
  ASSIGNED
}

enum DormitoryGenderPolicy {
  M
  F
  BOTH
}

enum DormitoryBathroomType {
  SHARED
  PRIVATE
}

enum SeasonOverrideState {
  OFF_SEASON
  SEASON_OPEN
  SEASON_MATCHING
  SEASON_POST_MATCH
}

enum SeasonParticipationIntent {
  UNDECIDED
  REGISTERED
  DECLINED
}

enum ParticipantStatus {
  NOT_STARTED
  DRAFT
  ACTIVE
  MATCHED
  WITHDRAWN
  EXPIRED
}

enum ParticipantHiddenReasonCode {
  POLICY_VIOLATION
  SAFETY_REVIEW
  ADMIN_REQUEST
  OTHER
}

enum MatchRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED_BY_REQUESTER
  CANCELLED_BY_SYSTEM
  EXPIRED
}

enum MatchRequestTerminalReason {
  ACCEPTED
  REJECTED_BY_RECEIVER
  CANCELLED_BY_REQUESTER
  CANCELLED_BY_SYSTEM_ACTIVE_MATCH
  EXPIRED
  WITHDRAWN_PARTICIPANT
  ADMIN_ACTION
}

enum MatchRequestChannel {
  ROOMMATE_TAB
  PROFILE_DETAIL
  RECOMMENDATION
  ADMIN
}

enum ActiveMatchStatus {
  ACTIVE
  UNMATCHED
  SEASON_ENDED
  ADMIN_ENDED
}

enum ActiveMatchEndReason {
  UNMATCHED_BY_MUTUAL_CONSENT
  SEASON_ENDED
  ADMIN_ACTION
  WITHDRAWN_PARTICIPANT
}

enum ActiveMatchUnmatchRequestStatus {
  PENDING
  CANCELLED_BY_REQUESTER
  EXPIRED_BY_CUTOFF
  FULFILLED_BY_MUTUAL_CONSENT
}

enum SeasonMatchHistoryEntryType {
  REQUEST
  MATCH
}

enum SeasonMatchHistoryEntryResult {
  REQUEST_REJECTED
  REQUEST_CANCELLED
  REQUEST_EXPIRED
  MATCHED_SUCCESS
  UNMATCHED_AFTER_SUCCESS
}

enum ConversationThreadKind {
  DIRECT
  MATCHED
}

enum ConversationThreadStatus {
  OPEN
  READ_ONLY
  ARCHIVED
}

enum ConversationThreadClosedReason {
  ACTIVE_MATCH_CREATED
  ROOM_SELECTION_CUTOFF
  SEASON_ENDED
  PARTICIPANT_WITHDRAWN
  MODERATION
  ADMIN_ACTION
}

enum ConversationThreadMemberState {
  ACTIVE
  LEFT
}

model CampusMaster {
  code         Campus              @id
  nameKo       String
  isOperated   Boolean
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @db.Timestamptz(3)
  colleges     CollegeMaster[]
  dormitories  Dormitory[]
  seasons      Season[]
  guideContent CampusGuideContent?
}

model CampusGuideContent {
  campusCode        Campus       @id
  homepageUrl       String
  commonRules       Json
  emergencyContacts Json
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @default(now()) @db.Timestamptz(3)
  campus            CampusMaster @relation(fields: [campusCode], references: [code], onDelete: Cascade)
}

model CollegeMaster {
  code                      String                     @id
  campusCode                Campus
  nameKo                    String
  sortOrder                 Int                        @default(0)
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  campus                    CampusMaster               @relation(fields: [campusCode], references: [code], onDelete: Restrict)
  userProfiles              UserProfile[]
  seasonParticipantProfiles SeasonParticipantProfile[]

  @@unique([campusCode, nameKo])
  @@index([campusCode, sortOrder])
}

model Dormitory {
  id                 String                     @id
  campusCode         Campus
  nameKo             String
  roomType           Int
  genderPolicy       DormitoryGenderPolicy
  sortOrder          Int                        @default(0)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @default(now()) @db.Timestamptz(3)
  campus             CampusMaster               @relation(fields: [campusCode], references: [code], onDelete: Restrict)
  guide              DormitoryGuide?
  seasonOperations   SeasonDormitoryOperation[]
  seasonParticipants SeasonParticipant[]
  users              User[]

  @@index([campusCode, genderPolicy, sortOrder])
}

model DormitoryGuide {
  dormitoryId   String                @id
  bathroomType  DormitoryBathroomType
  facilities    Json
  repairContact String
  diningContact String?
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @default(now()) @db.Timestamptz(3)
  dormitory     Dormitory             @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
}

model Season {
  id                   String                     @id @default(cuid())
  campusCode           Campus                     @default(CHUNCHEON)
  academicYear         Int
  semester             Int
  name                 String
  preparationStartDate DateTime                   @db.Date
  matchingStartDate    DateTime                   @db.Date
  seasonEndDate        DateTime                   @db.Date
  overrideState        SeasonOverrideState?
  overrideReason       String?
  overrideStartedAt    DateTime?                  @db.Timestamptz(3)
  overrideEndsAt       DateTime?                  @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @default(now()) @db.Timestamptz(3)
  campus               CampusMaster               @relation(fields: [campusCode], references: [code], onDelete: Restrict)
  dormitoryOperations  SeasonDormitoryOperation[]
  participants         SeasonParticipant[]
  matchRequests        MatchRequest[]
  activeMatches        ActiveMatch[]
  matchHistoryEntries  SeasonMatchHistoryEntry[]
  conversationThreads  ConversationThread[]

  @@unique([campusCode, academicYear, semester])
  @@index([campusCode, matchingStartDate])
  @@index([campusCode, seasonEndDate])
}

model SeasonDormitoryOperation {
  seasonId          String
  dormitoryId       String
  isOperated        Boolean   @default(true)
  roomSelectionDate DateTime  @db.Date
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @db.Timestamptz(3)
  season            Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  dormitory         Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@id([seasonId, dormitoryId])
  @@index([seasonId, isOperated, roomSelectionDate])
  @@index([dormitoryId, roomSelectionDate])
}

model User {
  id                      String                  @id @default(uuid())
  email                   String
  emailNormalized         String                  @unique
  passwordHash            String
  gender                  Gender
  campus                  Campus
  dormitoryId             String?
  dormitorySelectionState DormitorySelectionState @default(NOT_SELECTED)
  emailVerifiedAt         DateTime?               @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @default(now()) @db.Timestamptz(3)
  dormitory               Dormitory?              @relation(fields: [dormitoryId], references: [id], onDelete: SetNull)
  authSessions            AuthSession[]
  profile                 UserProfile?
  seasonParticipants      SeasonParticipant[]

  @@index([campus, dormitorySelectionState])
  @@index([dormitoryId])
}

model UserProfile {
  userId             String         @id
  nickname           String
  nicknameNormalized String         @unique
  nicknameChangedAt  DateTime?      @db.Timestamptz(3)
  lifestyle          Json
  intro              String         @default("")
  messageToRoommate  String?
  collegeCode        String?
  grade              String?
  mbti               String?
  birthYear          Int?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @default(now()) @db.Timestamptz(3)
  collegeRef         CollegeMaster? @relation(fields: [collegeCode], references: [code], onDelete: SetNull)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nickname])
  @@index([collegeCode])
}

model SeasonParticipant {
  id                      String                       @id @default(uuid())
  seasonId                String
  userId                  String
  participationIntent     SeasonParticipationIntent    @default(UNDECIDED)
  registeredAt            DateTime?                    @db.Timestamptz(3)
  declinedAt              DateTime?                    @db.Timestamptz(3)
  dormitoryId             String?
  dormitorySelectionState DormitorySelectionState      @default(NOT_SELECTED)
  participantStatus       ParticipantStatus            @default(NOT_STARTED)
  campusCodeSnapshot      Campus
  genderSnapshot          Gender
  joinedAt                DateTime                     @default(now()) @db.Timestamptz(3)
  activatedAt             DateTime?                    @db.Timestamptz(3)
  matchedAt               DateTime?                    @db.Timestamptz(3)
  withdrawnAt             DateTime?                    @db.Timestamptz(3)
  expiredAt               DateTime?                    @db.Timestamptz(3)
  hiddenByAdminAt         DateTime?                    @db.Timestamptz(3)
  hiddenReasonCode        ParticipantHiddenReasonCode?
  hiddenReasonDetail      String?
  deactivatedAt           DateTime?                    @db.Timestamptz(3)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                     @default(now()) @db.Timestamptz(3)
  dormitory               Dormitory?                   @relation(fields: [dormitoryId], references: [id], onDelete: SetNull)
  season                  Season                       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user                    User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile                 SeasonParticipantProfile?
  sentMatchRequests       MatchRequest[]               @relation("MatchRequestRequester")
  receivedMatchRequests   MatchRequest[]               @relation("MatchRequestReceiver")
  activeMatchesAsA        ActiveMatch[]                @relation("ActiveMatchParticipantA")
  activeMatchesAsB        ActiveMatch[]                @relation("ActiveMatchParticipantB")
  activeMatchUnmatchRequests ActiveMatchUnmatchRequest[]
  viewedMatchHistoryEntries SeasonMatchHistoryEntry[]  @relation("SeasonMatchHistoryViewer")
  counterpartMatchHistoryEntries SeasonMatchHistoryEntry[] @relation("SeasonMatchHistoryCounterpart")
  openedThreads           ConversationThread[]         @relation("ConversationThreadOpenedBy")
  threadsAsA              ConversationThread[]         @relation("ConversationThreadParticipantA")
  threadsAsB              ConversationThread[]         @relation("ConversationThreadParticipantB")
  threadMembers           ConversationThreadMember[]
  sentMessages            ConversationMessage[]        @relation("ConversationMessageSender")

  @@unique([seasonId, userId])
  @@index([userId, seasonId])
  @@index([seasonId, dormitoryId, dormitorySelectionState])
  @@index([seasonId, participantStatus])
}

model SeasonParticipantProfile {
  participantId                      String            @id
  nicknameSnapshot                   String
  nicknameNormalizedSnapshot         String
  lifestyle                          Json
  intro                              String            @default("")
  messageToRoommate                  String?
  collegeCode                        String?
  grade                              String?
  mbti                               String?
  birthYear                          Int?
  templateSourceUserProfileUpdatedAt DateTime?         @db.Timestamptz(3)
  createdAt                          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime          @default(now()) @db.Timestamptz(3)
  collegeRef                         CollegeMaster?    @relation(fields: [collegeCode], references: [code], onDelete: SetNull)
  participant                        SeasonParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([collegeCode])
  @@index([nicknameNormalizedSnapshot])
}

model MatchRequest {
  id                     String                      @id @default(uuid())
  seasonId               String
  pairKey                String
  pairMinParticipantId   String
  pairMaxParticipantId   String
  requesterParticipantId String
  receiverParticipantId  String
  note                   String?
  status                 MatchRequestStatus          @default(PENDING)
  terminalReason         MatchRequestTerminalReason?
  createdAt              DateTime                    @default(now()) @db.Timestamptz(3)
  expiresAt              DateTime                    @db.Timestamptz(3)
  terminalAt             DateTime?                   @db.Timestamptz(3)
  acceptedAt             DateTime?                   @db.Timestamptz(3)
  requestChannel         MatchRequestChannel?
  season                 Season                      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  requesterParticipant   SeasonParticipant           @relation("MatchRequestRequester", fields: [requesterParticipantId], references: [id], onDelete: Cascade)
  receiverParticipant    SeasonParticipant           @relation("MatchRequestReceiver", fields: [receiverParticipantId], references: [id], onDelete: Cascade)
  createdActiveMatch     ActiveMatch?                @relation("ActiveMatchCreatedFromRequest")

  @@index([seasonId, requesterParticipantId, receiverParticipantId, createdAt])
  @@index([seasonId, receiverParticipantId, status])
  @@index([expiresAt, status])
  @@index([seasonId, pairKey, status])
}

model ActiveMatch {
  id                   String                      @id @default(uuid())
  seasonId             String
  pairKey              String
  participantAId       String
  participantBId       String
  createdFromRequestId String                      @unique
  status               ActiveMatchStatus           @default(ACTIVE)
  startedAt            DateTime                    @default(now()) @db.Timestamptz(3)
  endedAt              DateTime?                   @db.Timestamptz(3)
  endReason            ActiveMatchEndReason?
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                    @default(now()) @db.Timestamptz(3)
  season               Season                      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  participantA         SeasonParticipant           @relation("ActiveMatchParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB         SeasonParticipant           @relation("ActiveMatchParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  createdFromRequest   MatchRequest                @relation("ActiveMatchCreatedFromRequest", fields: [createdFromRequestId], references: [id], onDelete: Restrict)
  unmatchRequests      ActiveMatchUnmatchRequest[]
  conversationThread   ConversationThread?

  @@index([seasonId, pairKey, endedAt])
  @@index([participantAId, endedAt])
  @@index([participantBId, endedAt])
  @@index([seasonId, status, endedAt])
}

model ActiveMatchUnmatchRequest {
  id            String                         @id @default(uuid())
  activeMatchId String
  participantId String
  status        ActiveMatchUnmatchRequestStatus @default(PENDING)
  requestedAt   DateTime                       @default(now()) @db.Timestamptz(3)
  terminalAt    DateTime?                      @db.Timestamptz(3)
  createdAt     DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                       @default(now()) @db.Timestamptz(3)
  activeMatch   ActiveMatch                    @relation(fields: [activeMatchId], references: [id], onDelete: Cascade)
  participant   SeasonParticipant              @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([activeMatchId, status, requestedAt])
  @@index([participantId, status, requestedAt])
}

model SeasonMatchHistoryEntry {
  id                        String                        @id @default(uuid())
  seasonId                  String
  viewerParticipantId       String
  counterpartParticipantId  String
  pairKey                   String
  entryType                 SeasonMatchHistoryEntryType
  entryResult               SeasonMatchHistoryEntryResult
  viewerRequested           Boolean
  sourceRequestId           String?
  sourceActiveMatchId       String?
  createdFromRequestId      String?
  counterpartNicknameSnapshot String
  viewerDormitoryIdSnapshot String?
  hadConversation           Boolean                       @default(false)
  matchedAt                 DateTime?                     @db.Timestamptz(3)
  unmatchedAt               DateTime?                     @db.Timestamptz(3)
  finalizedAt               DateTime                      @db.Timestamptz(3)
  requestTerminalReason     MatchRequestTerminalReason?
  activeMatchEndReason      ActiveMatchEndReason?
  threadClosedReason        ConversationThreadClosedReason?
  threadClosedAt            DateTime?                     @db.Timestamptz(3)
  createdAt                 DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                      @default(now()) @db.Timestamptz(3)
  season                    Season                        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  viewerParticipant         SeasonParticipant             @relation("SeasonMatchHistoryViewer", fields: [viewerParticipantId], references: [id], onDelete: Cascade)
  counterpartParticipant    SeasonParticipant             @relation("SeasonMatchHistoryCounterpart", fields: [counterpartParticipantId], references: [id], onDelete: Cascade)

  @@index([seasonId, viewerParticipantId, finalizedAt])
  @@index([viewerParticipantId, counterpartParticipantId, finalizedAt])
  @@index([seasonId, pairKey, finalizedAt])
}


model ConversationThread {
  id                  String                         @id @default(uuid())
  seasonId            String
  pairKey             String
  participantAId      String
  participantBId      String
  openedByParticipantId String
  threadKind          ConversationThreadKind
  activeMatchId       String?                        @unique
  status              ConversationThreadStatus       @default(OPEN)
  closedReason        ConversationThreadClosedReason?
  closedAt            DateTime?                      @db.Timestamptz(3)
  lastMessageAt       DateTime?                      @db.Timestamptz(3)
  createdAt           DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                       @default(now()) @db.Timestamptz(3)
  season              Season                         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  participantA        SeasonParticipant              @relation("ConversationThreadParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB        SeasonParticipant              @relation("ConversationThreadParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  openedByParticipant SeasonParticipant              @relation("ConversationThreadOpenedBy", fields: [openedByParticipantId], references: [id], onDelete: Cascade)
  activeMatch         ActiveMatch?                   @relation(fields: [activeMatchId], references: [id], onDelete: SetNull)
  members             ConversationThreadMember[]
  messages            ConversationMessage[]

  @@index([seasonId, pairKey, status])
  @@index([participantAId])
  @@index([participantBId])
}

model ConversationThreadMember {
  threadId       String
  participantId  String
  memberState    ConversationThreadMemberState      @default(ACTIVE)
  leftAt         DateTime?                          @db.Timestamptz(3)
  mutedAt        DateTime?                          @db.Timestamptz(3)
  lastReadAt     DateTime?                          @db.Timestamptz(3)
  lastVisibleAt  DateTime?                          @db.Timestamptz(3)
  createdAt      DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                           @default(now()) @db.Timestamptz(3)
  thread         ConversationThread                 @relation(fields: [threadId], references: [id], onDelete: Cascade)
  participant    SeasonParticipant                  @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([threadId, participantId])
}

model ConversationMessage {
  id                   String                       @id @default(uuid())
  threadId             String
  senderParticipantId  String
  body                 String
  sentAt               DateTime                     @default(now()) @db.Timestamptz(3)
  deletedAt            DateTime?                    @db.Timestamptz(3)
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  thread               ConversationThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderParticipant    SeasonParticipant            @relation("ConversationMessageSender", fields: [senderParticipantId], references: [id], onDelete: Cascade)

  @@index([threadId, sentAt])
  @@index([senderParticipantId, sentAt])
}

model LoginAttempt {
  id              String    @id @default(uuid())
  emailNormalized String    @unique
  failureCount    Int       @default(0)
  lockedUntil     DateTime? @db.Timestamptz(3)
  lastFailedAt    DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @db.Timestamptz(3)
}

model VerificationCode {
  id              String                  @id @default(uuid())
  emailNormalized String
  purpose         VerificationCodePurpose
  codeHash        String
  failedAttempts  Int                     @default(0)
  issuedAt        DateTime                @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime                @db.Timestamptz(3)
  verifiedAt      DateTime?               @db.Timestamptz(3)
  consumedAt      DateTime?               @db.Timestamptz(3)
  requestIp       String?

  @@index([emailNormalized, purpose])
}

model VerificationCodeRequestLog {
  id              String                  @id @default(uuid())
  emailNormalized String
  purpose         VerificationCodePurpose
  requestIp       String
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)

  @@index([emailNormalized, purpose, requestIp, createdAt])
  @@index([requestIp, createdAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  rememberMe       Boolean   @default(false)
  refreshTokenHash String?
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ModerationTerm {
  id             String                 @id @default(uuid())
  term           String
  normalizedTerm String
  category       ModerationTermCategory
  matchMode      ModerationMatchMode
  surface        ModerationSurface
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @default(now()) @db.Timestamptz(3)

  @@unique([normalizedTerm, category, matchMode, surface])
  @@index([surface, category, isActive])
}
