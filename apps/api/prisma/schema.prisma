/// Retained vault payload의 보존 case/hold owner. 계정 식별 anchor 보존 사유와 분리된다.
model RetentionCase {
  id                        String                    @id @default(uuid())
  reason                    RetentionCaseReason
  triggerUserId             String?
  triggerRetainedIdentityId String?
  sourceTable               String?
  sourceId                  String?
  retentionHoldUntil        DateTime?                 @db.Timestamptz(3)
  legalHoldReason           LegalHoldReason?
  approvalReference         String?
  policyVersion             String
  metadata                  Json?
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  triggerRetainedIdentity   RetainedIdentity?         @relation("RetentionCaseTriggerIdentity", fields: [triggerRetainedIdentityId], references: [id], onDelete: SetNull)
  vaultHolds                RetainedVaultObjectHold[]
  identityHolds             RetainedIdentityHold[]

  @@index([reason, retentionHoldUntil])
  @@index([triggerRetainedIdentityId, reason])
  @@index([sourceTable, sourceId])
}

/// RRPD payload의 암호화 보존 단위. 일반 product read path에서 복원하지 않는다.
model RetainedVaultObject {
  id                          String                                  @id @default(uuid())
  target                      RetainedVaultObjectTarget
  sourceTable                 String
  sourceId                    String
  archiveJobId                String?
  subjectUserId               String?
  subjectRetainedIdentityId   String?
  subjectParticipantId        String?
  subjectRole                 RetainedVaultSubjectRole
  payloadSchemaVersion        Int
  encryptedPayload            Json?
  payloadDigest               String?
  keyPurpose                  String
  keyVersion                  String?
  aad                         String
  state                       RetainedVaultObjectState                @default(RETAINED)
  retainedAt                  DateTime                                @default(now()) @db.Timestamptz(3)
  disposedAt                  DateTime?                               @db.Timestamptz(3)
  disposalReason              String?
  metadata                    Json?
  createdAt                   DateTime                                @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                                @default(now()) @updatedAt @db.Timestamptz(3)
  archiveJob                  ArchiveJob?                             @relation(fields: [archiveJobId], references: [id], onDelete: SetNull)
  subjectRetainedIdentity     RetainedIdentity?                       @relation("RetainedVaultObjectSubjectIdentity", fields: [subjectRetainedIdentityId], references: [id], onDelete: SetNull)
  holds                       RetainedVaultObjectHold[]
  accessLogs                  RetentionAccessLog[]
  chatMessage                 ConversationMessage?                    @relation("ConversationMessageRetainedVaultObject")
  nicknameChangeEvent         UserDisplayIdentityNicknameChangeEvent? @relation("NicknameEventRetainedVaultObject")
  academicIdentityChangeEvent UserAcademicIdentityChangeEvent?        @relation("AcademicIdentityEventRetainedVaultObject")
  profileHistory              SeasonParticipantProfileHistory?        @relation("ProfileHistoryRetainedVaultObject")
  matchHistoryLink            SeasonMatchHistoryEntryRetentionLink?   @relation("MatchHistoryLinkRetainedVaultObject")

  @@unique([target, sourceId, subjectRole])
  @@index([target, sourceId])
  @@index([archiveJobId])
  @@index([subjectRetainedIdentityId, target, retainedAt])
  @@index([state, retainedAt])
}

model RetainedVaultObjectHold {
  id                    String              @id @default(uuid())
  retainedVaultObjectId String
  retentionCaseId       String
  holdReason            RetentionCaseReason
  holdUntil             DateTime?           @db.Timestamptz(3)
  releasedAt            DateTime?           @db.Timestamptz(3)
  releaseReason         String?
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  retainedVaultObject   RetainedVaultObject @relation(fields: [retainedVaultObjectId], references: [id], onDelete: Cascade)
  retentionCase         RetentionCase       @relation(fields: [retentionCaseId], references: [id], onDelete: Cascade)

  @@unique([retainedVaultObjectId, retentionCaseId])
  @@index([retentionCaseId, holdUntil])
  @@index([holdReason, holdUntil])
}

model RetainedIdentityHold {
  id                 String              @id @default(uuid())
  retainedIdentityId String
  retentionCaseId    String
  holdReason         RetentionCaseReason
  holdUntil          DateTime?           @db.Timestamptz(3)
  releasedAt         DateTime?           @db.Timestamptz(3)
  releaseReason      String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  retainedIdentity   RetainedIdentity    @relation(fields: [retainedIdentityId], references: [id], onDelete: Cascade)
  retentionCase      RetentionCase       @relation(fields: [retentionCaseId], references: [id], onDelete: Cascade)

  @@unique([retainedIdentityId, retentionCaseId])
  @@index([retentionCaseId, holdUntil])
  @@index([holdReason, holdUntil])
}

model RetentionAccessLog {
  id                         String                     @id @default(uuid())
  targetType                 RetentionAccessTargetType
  retainedIdentityId         String?
  retainedVaultObjectId      String?
  vaultTarget                RetainedVaultObjectTarget?
  accessedBy                 String?
  accessReason               RetentionAccessReason
