# local/staging stress fixture target
STRESS_TARGET_URL=http://127.0.0.1:4000
STRESS_ENV=local
STRESS_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# Production-like targets are denied unless this exact value is set for an approved run.
# STRESS_ALLOW_PRODUCTION=I_UNDERSTAND

# deterministic fixture shape
STRESS_FIXTURE_PREFIX=stress-local
STRESS_CAMPUS_CODE=CHUNCHEON
STRESS_SEASON_ID=stress-season-local
STRESS_LARGEST_COHORT_SIZE=237
STRESS_COHORT_SIZE=946
STRESS_DORMITORY_COUNT=4
STRESS_ROOM_TYPE=2
# 운영·개발 seed의 실제 학기 unique key와 충돌하지 않는 fixture 전용 연도
STRESS_ACADEMIC_YEAR=2099
STRESS_SEMESTER=1
# local/staging-only DB mutation opt-in. Never set on production API/DB hosts.
# STRESS_FIXTURE_APPLY=I_UNDERSTAND_STAGING_FIXTURE

# actor token artifact generated by stress:fixture:tokens
STRESS_ACTOR_TOKENS_PATH=test/stress/reports/.tmp-stress-actor-tokens.json
# Local smoke는 auth login throttle을 피하기 위해 작게 시작한다.
STRESS_TOKEN_ACTOR_LIMIT=3

# Login real/dummy Argon2id capacity. actor count must not exceed the seeded fixture cohort.
STRESS_AUTH_ACTOR_COUNT=25
STRESS_AUTH_LOGIN_VUS=10
STRESS_AUTH_LOGIN_DURATION=2m

# Password reset request/invalid-code abuse rehearsal. Use local/staging only.
STRESS_AUTH_RECOVERY_RATE=2
STRESS_AUTH_RECOVERY_DURATION=2m

# write-heavy k6 mix remains opt-in after fixture seed/token generation
STRESS_ENABLE_WRITE_MIX=false

# Artillery realtime Socket.IO stress
# Generated from STRESS_ACTOR_TOKENS_PATH by stress:realtime:smoke runner. Keep .tmp-* ignored.
STRESS_ARTILLERY_ACTOR_CSV_PATH=test/stress/reports/.tmp-realtime-actors.csv
STRESS_ARTILLERY_SUMMARY_PATH=test/stress/reports/.tmp-realtime-summary.json
# Defaults to ${STRESS_TARGET_URL}/chat when omitted.
STRESS_REALTIME_SOCKET_URL=http://127.0.0.1:4000/chat
# Defaults to STRESS_TARGET_URL origin when omitted.
STRESS_REALTIME_ORIGIN=http://127.0.0.1:4000
# Optional processor ack timeout for custom debug hooks.
STRESS_ARTILLERY_ACK_TIMEOUT_MS=3000
# Optional Artillery debug when investigating socket failures
# DEBUG=socketio

# Argon2id endpoint-mix capacity gate. Each invocation runs one H1-H9 profile.
STRESS_AUTH_CAPACITY_PROFILE=h1
# Optional short smoke override. Set both values together.
# STRESS_AUTH_CAPACITY_RATE=1
# STRESS_AUTH_CAPACITY_DURATION=10s
# Optional explicit wiring-smoke mix. Docker runner enables this automatically with both overrides.
# STRESS_AUTH_CAPACITY_SMOKE_MIX=true
STRESS_AUTH_CAPACITY_SIGNUP_COUNT=320
STRESS_AUTH_CAPACITY_ARTIFACT_PATH=test/stress/reports/.tmp-auth-password-capacity.json

# Raw Argon2id micro calibration. Local output is diagnostic, not release evidence.
STRESS_AUTH_HASH_MICRO_LEVELS=1,5,10,20,40,100
# STRESS_AUTH_HASH_MICRO_REPORT_PATH=test/stress/reports/.tmp-auth-password-hash-micro.json
