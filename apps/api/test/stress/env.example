# local/staging stress fixture target
STRESS_TARGET_URL=http://127.0.0.1:4000
STRESS_ENV=local
STRESS_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# Production-like targets are denied unless this exact value is set for an approved run.
# STRESS_ALLOW_PRODUCTION=I_UNDERSTAND

# deterministic fixture shape
STRESS_FIXTURE_PREFIX=stress-local
STRESS_CAMPUS_CODE=CHUNCHEON
STRESS_SEASON_ID=stress-season-local
STRESS_LARGEST_COHORT_SIZE=237
STRESS_COHORT_SIZE=946
STRESS_DORMITORY_COUNT=4
STRESS_ROOM_TYPE=2
STRESS_ACADEMIC_YEAR=2026
STRESS_SEMESTER=1
