{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "stripLeadingPaths": true,
        "extensions": [".ts"],
        "ignore": [
          "**/*.spec.ts",
          "**/*.e2e-spec.ts",
          "**/*.spec-fixtures.ts",
          "**/test-support/**"
        ]
      }
    }
  }
}
