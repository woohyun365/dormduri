# Runtime URL for application traffic. In production, prefer a pooled/pooler URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knu_roommate?schema=public"
# Direct connection used by Prisma CLI (migrate/introspect/admin).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/knu_roommate?schema=public"
PORT=4000
JWT_SECRET="<generate-with-openssl-rand-base64-32>"
VERIFICATION_CODE_HMAC_SECRET="<generate-with-openssl-rand-base64-32>"

# Optional runtime pool tuning for pg / @prisma/adapter-pg
# DATABASE_POOL_MAX=10
# DATABASE_POOL_MIN=0
# DATABASE_ADAPTER_CONNECT_TIMEOUT_MS=5000
# DATABASE_ADAPTER_IDLE_TIMEOUT_MS=300000
# DATABASE_QUERY_TIMEOUT_MS=0
# DATABASE_STATEMENT_TIMEOUT_MS=0
# DATABASE_APPLICATION_NAME="knu-roommate-api"
