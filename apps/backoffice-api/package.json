{
  "name": "backoffice-api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "pnpm run ci:prepare && pnpm run ci:build",
    "start:prod": "node dist/main",
    "bootstrap-owner": "node dist/cli/bootstrap-owner",
    "lint": "pnpm run ci:prepare && pnpm run ci:lint",
    "typecheck": "pnpm run ci:prepare && pnpm run ci:typecheck",
    "test": "pnpm run ci:prepare && pnpm run ci:test:unit",
    "test:integration": "pnpm run ci:prepare && pnpm run ci:test:integration",
    "ci:prepare": "pnpm --filter @repo/shared build && pnpm --filter @repo/database prisma:generate && pnpm --filter @repo/database build",
    "ci:build": "nest build",
    "ci:lint": "eslint",
    "ci:typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "ci:test:unit": "vitest run --config ./vitest.config.unit.ts --maxWorkers=50%",
    "ci:test:integration": "vitest run --config ./vitest.config.integration.ts --maxWorkers=2"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-node": "^12.3.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prometheus-io/client": "^0.16.1",
    "@repo/database": "workspace:*",
    "@repo/shared": "workspace:*",
    "@simplewebauthn/server": "^14.1.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "^17.13.0",
    "prettier": "catalog:",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
