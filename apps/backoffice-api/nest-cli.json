{
  "$schema": "https://json.schemastore.org/nest-cli",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "builder": {
      "type": "swc",
      "options": {
        "stripLeadingPaths": true,
        "extensions": [".ts"],
        "ignore": ["**/*.spec.ts"]
      }
    }
  }
}
