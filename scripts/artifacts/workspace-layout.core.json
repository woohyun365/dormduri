{
  "schema": "htc-workspace-layout-core/v1",
  "guide": "docs/development/agent-workflows/workspace-layout.md",
  "retentionClasses": [
    "current-input",
    "regenerable-output",
    "historical-observation",
    "sensitive-or-undetermined"
  ],
  "retentionUntil": ["plan-closed", "task-settled"],
  "creators": ["core-scaffold", "host-adapter", "overlay", "human", "repository-script"],
  "roots": [
    {
      "id": "plans",
      "path": ".htc/plans",
      "kind": "directory",
      "purpose": "계획 문서. 결정·상태·다음 행동만 담고 실행 기록은 artifacts에 두고 링크한다",
      "tracking": "tracked",
      "creator": ["human"],
      "children": "markdown-only",
      "copy": "allowed"
    },
    {
      "id": "artifacts",
      "path": ".htc/artifacts",
      "kind": "directory",
      "purpose": "계획 진행 증거(실행 증거·staging·review 기록). Plan ID 디렉터리 아래 phase 단위로 두고 README만 추적한다",
      "tracking": "ignored",
      "trackedFiles": ["README.md"],
      "creator": ["core-scaffold", "human", "repository-script"],
      "retention": { "class": "current-input", "until": "plan-closed" },
      "copy": "unspecified"
    },
    {
      "id": "state",
      "path": ".htc/state",
      "kind": "directory",
      "purpose": "host adapter runtime 기록. 그 checkout에 묶인다",
      "tracking": "ignored",
      "creator": ["host-adapter"],
      "retention": { "class": "current-input", "until": "task-settled" },
      "copy": "forbidden"
    },
    {
      "id": "product",
      "path": "docs/product",
      "kind": "directory",
      "purpose": "PRD 묶음",
      "tracking": "tracked",
      "creator": ["human"],
      "copy": "allowed"
    },
    {
      "id": "policies",
      "path": "docs/policies",
      "kind": "directory",
      "purpose": "제품·보안·운영 불변 정책",
      "tracking": "tracked",
      "creator": ["human"],
      "copy": "allowed"
    },
    {
      "id": "architecture",
      "path": "docs/architecture",
      "kind": "directory",
      "purpose": "책임 경계와 설계 결정(L1 개요)",
      "tracking": "tracked",
      "creator": ["human"],
      "copy": "allowed"
    },
    {
      "id": "decisions",
      "path": "docs/architecture/decisions",
      "kind": "directory",
      "purpose": "설계 결정 기록(L2)",
      "tracking": "tracked",
      "creator": ["human"],
      "copy": "allowed"
    },
    {
      "id": "artifact-map",
      "path": "docs/product/artifact-map.json",
      "kind": "file",
      "purpose": "제품 문서와 추적 산출물의 대응 기록",
      "tracking": "tracked",
      "creator": ["human"],
      "copy": "allowed"
    },
    {
      "id": "path-domains",
      "path": "docs/policies/path-domains.json",
      "kind": "file",
      "purpose": "경로와 정책 도메인의 대응 표",
      "tracking": "tracked",
      "creator": ["human"],
      "copy": "allowed"
    }
  ],
  "workNames": {
    "phase": "^(p[0-9]+[a-z]?|[a-z]{1,3}[0-9]+[a-z]?|[0-9]{4}-[0-9]{2}-[0-9]{2})$",
    "topic": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "host": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "at": "^[0-9]{8}T[0-9]{4}$",
    "spec": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "skill": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "run": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "workKinds": [
    {
      "id": "research",
      "purpose": "근거 snapshot과 조사 원문",
      "directories": ["research"]
    },
    {
      "id": "plan-drafts",
      "purpose": "계획 초안 staging, 원본 manifest, promote receipt",
      "directories": ["plan-drafts"]
    },
    {
      "id": "evidence",
      "purpose": "phase 실행 증거. phase 디렉터리 자체",
      "directories": []
    },
    {
      "id": "review",
      "purpose": "리뷰 입력·runner와 정산 뒤 쓰는 회차별 결과(read path 밖)",
      "directories": ["review", "review-results"]
    },
    {
      "id": "live",
      "purpose": "host live 실행 receipt",
      "directories": ["live/{host}-{at}"]
    },
    {
      "id": "impact",
      "purpose": "영향 목록 입력(spec)과 --out 출력(out)",
      "directories": ["impact/{spec}/spec", "impact/{spec}/out"]
    },
    {
      "id": "skill-outputs",
      "purpose": "skill 산출물. 하위 구조는 domain pack이 등록한다",
      "directories": ["outputs/{skill}/{run}"]
    }
  ]
}
