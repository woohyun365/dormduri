#!/bin/bash
# API document harness의 가짜 docker. migrate one-off는 secret 파일 넷이 0400·10001일 때만 돌고(BAD_STEP 단계는 실패),
# api up은 secret release 디렉터리가 0500·10001일 때만 뜬다(BAD_UP digest는 실패). exec web은 host 안 smoke다(BAD_SMOKE).
# 관측: create·cp는 설정 image를 흉내 내 fixture 설정을 펼치고(BAD_CONFIG=partial은 파일 하나를 빼고 symlink는 symlink를 더함),
# 관측 up은 설정 경로와 관측 secret 파일 셋이 그 container UID 소유 0400일 때만 뜬다(BAD_OBS_UP은 실패).
. /work/common.sh
echo "docker $*" >>/tmp/docker.log
[ "$1" = login ] && cat >/dev/null
docker_common "$@"
case "$1" in
  pull)
    case "${*: -1}" in *observability-config@*) [ -z "${BAD_OBS_PULL:-}" ] || exit 1 ;; esac
    exit 0
    ;;
  create)
    echo "cid-${*: -2:1}" | sed 's/.*@sha256:\(.\).*/cid-\1/'
    exit 0
    ;;
  cp)
    dest=${3%/}
    for file in alloy/config.alloy alloy/pipeline.alloy loki/loki.yml loki/rules/web-bff-alerts.yml \
      prometheus/prometheus.production.yml prometheus/rules/api-alerts.yml alertmanager/alertmanager.production.yml \
      alertmanager/templates/slack.tmpl grafana/provisioning/datasources/datasources.yml; do
      [ "${BAD_CONFIG:-}" = partial ] && [ "${file}" = prometheus/prometheus.production.yml ] && continue
      mkdir -p "${dest}/$(dirname "${file}")"
      printf 'fixture %s\n' "${file}" >"${dest}/${file}"
    done
    [ "${BAD_CONFIG:-}" = symlink ] && ln -s /etc/shadow "${dest}/alloy/extra"
    exit 0
    ;;
  rm) exit 0 ;;
esac
[ "$1" = compose ] || exit 0
compose_args "$@"
require_fragments
echo "${sub}:${services}" >>/tmp/services.log
case "${sub}" in
  run)
    step=${!#}
    for file in MIGRATION_DATABASE_URL DATABASE_URL RETENTION_WORKER_DATABASE_URL RETENTION_DISCLOSURE_DATABASE_URL; do
      [ "$(stat -c '%u:%a' "${MIGRATE_SECRET_DIR:-/nonexistent}/${file}" 2>/dev/null)" = 10001:400 ] || exit 3
    done
    echo "${step}" >>/tmp/steps.log
    [ "${BAD_STEP:-}" != "${step}" ]
    ;;
  stop) case " ${services} " in *" api "*) rm -f /tmp/running_api ;; esac ;;
  up)
    case " ${services} " in
      *" prometheus "*)
        [ -z "${BAD_OBS_UP:-}" ] || exit 1
        [ -f "${OBSERVABILITY_CONFIG_DIR:-/nonexistent}/prometheus/prometheus.production.yml" ] || exit 5
        s=/opt/dormduri/secrets/observability
        [ "$(stat -c '%u:%g:%a' "${s}/slack-webhook-url" "${s}/grafana-admin-password" "${s}/api-metrics-bearer-token" 2>/dev/null | paste -sd' ')" \
          = '65534:65534:400 472:0:400 65534:65534:400' ] || exit 6
        basename "${OBSERVABILITY_CONFIG_DIR}" | cut -c1 >/tmp/running_obs
        exit 0
        ;;
    esac
    [ "$(stat -c '%u:%a' "${API_SECRET_RELEASE_DIR:-/nonexistent}" 2>/dev/null)" = 10001:500 ] || exit 4
    api=${API_IMAGE##*@}
    case " ${BAD_UP:-} " in *" ${api} "*) exit 1 ;; esac
    printf '%s' "${api}" >/tmp/running_api
    ;;
  exec)
    [ -f /tmp/running_api ] || exit 1
    [ -z "${BAD_SMOKE:-}" ] || [ "$(cat /tmp/running_api)" != "${BAD_SMOKE}" ]
    ;;
esac
