#!/bin/bash
# 실제 ingress의 경로별 응답을 흉내 낸다: 점검 flag면 모든 경로 점검 중 503, 아니면 허용 경로 200·준비 중 503·404.
# PREVIOUS_TITLE_FORMAT(공백으로 나눈 web digest)에 든 쌍이 떠 있으면 정적 page 제목을 이전 형식으로 낸다(옛 ingress image).
. /work/titles.env
out=/dev/null
url=
while [ $# -gt 0 ]; do
  case "$1" in
    -o)
      out=$2
      shift 2
      ;;
    -w | --max-time | --resolve) shift 2 ;;
    -*) shift ;;
    *)
      url=$1
      shift
      ;;
  esac
done
path=/${url#https://*/}
[ "${url#https://*/}" = "${url}" ] && path=/
running=$(cat /tmp/running_web 2>/dev/null)
suffix=
case " ${PREVIOUS_TITLE_FORMAT:-} " in *" ${running} "*) [ -n "${running}" ] && suffix=_PREVIOUS ;; esac
if [ -f /opt/dormduri/mode/maintenance ]; then
  code=503
  title_var=TITLE_MAINTENANCE${suffix}
  title=${!title_var}
elif [ -n "${BAD_SMOKE:-}" ] && [ "${running}" = "${BAD_SMOKE}" ]; then
  code=500
  title=
else
  case "${path}" in
    / | /privacy | /terms)
      code=200
      title=
      ;;
    /signup)
      code=503
      title_var=TITLE_COMING_SOON${suffix}
      title=${!title_var}
      ;;
    *)
      code=404
      title_var=TITLE_NOT_FOUND${suffix}
      title=${!title_var}
      ;;
  esac
fi
printf '<title>%s</title>' "${title}" >"${out}"
printf '%s' "${code}"
