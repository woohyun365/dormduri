{
  "schema": "lifecycle-definition/v1",
  "strengths": [
    "deterministic-static",
    "native-runtime",
    "model-mediated",
    "advisory-policy",
    "human-judgment"
  ],
  "states": [
    { "id": "uninitialized", "layer": "project", "artifacts": [] },
    {
      "id": "intake",
      "layer": "project",
      "artifacts": ["요청 분류(변경 등급·intent)", "고위험 trigger 판정"]
    },
    {
      "id": "discovery",
      "layer": "project",
      "artifacts": ["PRD 개요 초안(draft)", "질문과 답"]
    },
    {
      "id": "product-defined",
      "layer": "project",
      "artifacts": ["PRD 개요(owner-confirmed)", "정책 도메인 목록"]
    },
    {
      "id": "policy-baseline",
      "layer": "project",
      "artifacts": [
        "cross-cutting 정책(법적 근거·데이터 보유·인증·권한 모델·실제 돈, 고위험 trigger 포함)"
      ]
    },
    {
      "id": "architected",
      "layer": "project",
      "artifacts": [
        "L1 아키텍처 개요(owner-confirmed)",
        "L1 결정의 L2 기록",
        "경로 → 정책 도메인 표"
      ]
    },
    {
      "id": "planned",
      "layer": "work",
      "artifacts": ["umbrella·bounded plan(PRD 기능 영역 문서와 링크)"]
    },
    {
      "id": "policy-ready",
      "layer": "work",
      "artifacts": ["바뀌는 도메인의 정책(owner-confirmed)", "L4 설계 절"]
    },
    {
      "id": "ready",
      "layer": "work",
      "artifacts": ["plan implementation-ready", "정책 규칙을 인용한 acceptance"]
    },
    {
      "id": "implementing",
      "layer": "work",
      "artifacts": ["branch", "정책 규칙에서 도출한 RED test", "구현"]
    },
    { "id": "reviewing", "layer": "work", "artifacts": ["독립 리뷰 결과"] },
    { "id": "merged", "layer": "work", "artifacts": ["PR", "CI"] },
    { "id": "evidenced", "layer": "work", "artifacts": ["evidence 원자료·승격"] }
  ],
  "guards": [
    {
      "id": "P-INIT",
      "state": "uninitialized",
      "input": ["repo binding(`.htc/config`. 이름 대응만 하는 저장소는 manifest의 대응 항목)"],
      "strength": ["deterministic-static"],
      "confirmer": "setup",
      "hook": "판정만",
      "ci": "binding이 없으면 뒤 guard를 계산하지 않고 경고",
      "checks": []
    },
    {
      "id": "P-GRADE",
      "state": "intake",
      "input": ["변경 등급·근거", "고위험 trigger 판정 기록"],
      "strength": ["model-mediated"],
      "confirmer": "agent",
      "hook": "기록",
      "ci": "PR 본문 `Lifecycle` 절 등급 줄 형식만. 등급과 diff 대조는 리뷰",
      "checks": []
    },
    {
      "id": "P-DIRECTION",
      "state": "discovery",
      "input": ["PRD 개요 header `owner-confirmed`"],
      "strength": ["deterministic-static"],
      "confirmer": "owner",
      "hook": "경고·기록",
      "ci": "`P-ARCH` 행으로 합산",
      "checks": []
    },
    {
      "id": "P-POLICY-SET",
      "state": "product-defined",
      "input": [
        "PRD 개요(또는 index)의 정책 도메인 목록",
        "cross-cutting 대상(고위험 trigger 포함)"
      ],
      "strength": ["deterministic-static"],
      "confirmer": "owner",
      "hook": "경고·기록",
      "ci": "`P-ARCH` 행으로 합산",
      "checks": []
    },
    {
      "id": "P-POLICY-BASE",
      "state": "policy-baseline",
      "input": [
        "cross-cutting 정책마다 header `owner-confirmed` 또는 추적 대응 기록의 `not-applicable` 확인"
      ],
      "strength": ["deterministic-static"],
      "confirmer": "owner",
      "hook": "경고·기록",
      "ci": "`P-ARCH` 행으로 합산",
      "checks": []
    },
    {
      "id": "P-ARCH",
      "state": "architected",
      "input": [
        "L1 개요 header `owner-confirmed`",
        "L2 결정 기록 존재",
        "경로 → 정책 도메인 표 존재"
      ],
      "strength": ["deterministic-static"],
      "confirmer": "owner",
      "hook": "제품 코드 쓰기 deny(판정 오류는 통과·기록)",
      "ci": "제품 경로를 바꾸는 PR에 `P-DIRECTION`~`P-ARCH` 근거가 없으면 fail. L1 확인 근거는 모든 등급에서 본다",
      "checks": []
    },
    {
      "id": "W-SCOPE",
      "state": "planned",
      "input": ["프로젝트 층 `architected`", "plan의 바뀌는 정책 도메인·하위 layer·경로 선언"],
      "strength": ["deterministic-static"],
      "confirmer": "parent",
      "hook": "경고·기록",
      "ci": "도메인 선언이 diff에 경로 표를 적용한 판정을 빠뜨리면 fail, 더 선언하면 경고(feature·policy-change). bugfix·hotfix는 경고",
      "checks": ["W-SCOPE"]
    },
    {
      "id": "W-POLICY",
      "state": "policy-ready",
      "input": [
        "바뀌는 정책 도메인마다 header `owner-confirmed` 또는 추적 대응 기록",
        "`R-UPSTREAM` 재확인 필요가 아님",
        "L4 설계 절 확인"
      ],
      "strength": ["deterministic-static", "model-mediated"],
      "confirmer": "owner",
      "hook": "경고·기록",
      "ci": "판정·선언 도메인에 owner-confirmed 근거가 없으면 fail(feature·policy-change). bugfix·hotfix는 경고",
      "checks": ["W-POLICY"]
    },
    {
      "id": "W-DESIGN",
      "state": "policy-ready",
      "input": ["시각 방향 확정 기록(확정 원문과 본 산출물의 경로·revision)"],
      "strength": ["human-judgment"],
      "confirmer": "owner-or-delegate",
      "condition": "visual-quality-claim",
      "hook": null,
      "ci": null,
      "checks": []
    },
    {
      "id": "W-READY",
      "state": "ready",
      "input": [
        "plan `implementation-ready`",
        "비가역 결정 확인",
        "acceptance의 정책 규칙 id 인용",
        "`R-UPSTREAM` 재확인 필요가 아님(readiness PASS 날짜 비교)"
      ],
      "strength": ["model-mediated", "deterministic-static"],
      "confirmer": "reviewer",
      "hook": "경고·기록",
      "ci": "PR 본문 readiness 근거 줄 형식과 인용 규칙 id 존재. PASS 날짜가 PRD 개요·L1·선언 도메인 정책의 확인일보다 이르면 fail(feature·policy-change만)",
      "checks": ["W-CITE"]
    },
    {
      "id": "W-PATHS",
      "state": "implementing",
      "input": ["바뀐 경로가 plan 경로 선언 안"],
      "strength": ["deterministic-static"],
      "confirmer": "parent",
      "hook": "범위 밖 쓰기 경고",
      "ci": "diff 경로가 PR 본문 변경 경로 범위(glob) 밖이면 fail(feature·policy-change). bugfix·hotfix는 경고, trivial은 계산하지 않음",
      "checks": []
    },
    {
      "id": "W-REVIEW",
      "state": "reviewing",
      "input": ["독립 리뷰 PASS", "정산"],
      "strength": ["model-mediated", "deterministic-static"],
      "confirmer": "reviewer",
      "hook": null,
      "ci": "`리뷰 PASS` snapshot과 PR head 대조, 재채점 줄. 경고만",
      "checks": ["W-REVIEW"]
    },
    {
      "id": "W-MERGE",
      "state": "merged",
      "input": ["required check green", "merge"],
      "strength": ["native-runtime"],
      "confirmer": "github",
      "hook": null,
      "ci": "required check(`CI summary`)",
      "checks": []
    },
    {
      "id": "W-EVID",
      "state": "evidenced",
      "input": ["evidence 단계 완료"],
      "strength": [],
      "confirmer": "evidence-stage",
      "hook": null,
      "ci": null,
      "checks": []
    }
  ],
  "reverse": [
    {
      "id": "R-AMBIG",
      "trigger": "구현 중 새 모호함·미정 결정",
      "target": ["planned", "policy-ready"],
      "rule": "구현을 멈추고 구현 불가 블록을 낸다. 정책 변경이 필요하면 policy-ready, 아니면 planned로 돌아가 정책을 먼저 고치고 test를 다시 도출한다. 결정 목록 밖이고 되돌림이 easy이며 선언 범위 안인 판단은 이 계기가 아니다",
      "detection": "agent 자기 보고, 리뷰"
    },
    {
      "id": "R-REVIEW",
      "trigger": "리뷰 finding이 정책·L2와 충돌",
      "target": ["policy-ready", "architected"],
      "rule": "코드를 정책에 맞추거나 정책·L2 변경을 Owner에게 묻는다. 정책을 몰래 코드에 맞추지 않는다",
      "detection": "리뷰"
    },
    {
      "id": "R-UPSTREAM",
      "trigger": "PRD·cross-cutting 정책·L1 변경",
      "target": "changed-artifact-state",
      "rule": "하위 산출물(plan·도메인 정책·L4)의 재확인 필요를 계산한다. header 문서는 근거 링크가 가리키는 상위 문서의 확인일이 자기 확인일보다 늦으면, plan은 readiness PASS 날짜가 PRD 개요·L1·선언 도메인 정책의 확인일보다 이르거나 선언 도메인 정책이 재확인 필요면 재확인 필요다",
      "detection": "header 확인일과 readiness PASS 날짜 비교"
    },
    {
      "id": "R-REJECT",
      "trigger": "Owner 확인 거절",
      "target": "reviewed-state-start",
      "rule": "검토 대상 상태의 처음으로만 돌아간다. W-DESIGN 확정 뒤 방향 기각은 policy-ready 처음이고, 탐색 중 후보 기각은 W-DESIGN 미충족이지 역전이가 아니다",
      "detection": "Owner 답 기록"
    },
    {
      "id": "R-SIGNAL",
      "trigger": "실패 신호: 요청 밖 기능, test 삭제·비활성, 같은 수정 반복",
      "target": {
        "trivial": "implementing",
        "bugfix": "baseline-check",
        "hotfix": "baseline-check",
        "feature": "ready",
        "policy-change": "ready"
      },
      "sameFixLimit": 3,
      "rule": "리뷰·검사가 탐지하면 blocking finding이고 plan 범위를 다시 본다. 같은 결함 수정이 sameFixLimit번 실패하면 멈추고 Owner에게 구조 문제인지 묻고, 구조 문제면 bugfix·hotfix를 feature로 올린다. 리뷰 회차의 연속 non-PASS quality stop과 다른 축이다",
      "detection": "리뷰. 수정 실패 횟수는 agent가 센다"
    }
  ],
  "grades": {
    "trivial": {
      "path": ["implementing", "reviewing", "merged", "evidenced"],
      "steps": [],
      "skip": ["W-SCOPE", "W-POLICY", "W-READY", "W-PATHS"],
      "warnOnly": []
    },
    "bugfix": {
      "path": ["policy-ready", "implementing", "reviewing", "merged", "evidenced"],
      "steps": ["baseline-check", "reproduce", "cause-hypothesis", "confirm", "red"],
      "skip": ["W-READY"],
      "warnOnly": ["W-SCOPE", "W-PATHS"]
    },
    "hotfix": {
      "path": ["policy-ready", "implementing", "reviewing", "merged", "evidenced"],
      "steps": ["baseline-check", "reproduce", "cause-hypothesis", "confirm", "red"],
      "skip": ["W-READY"],
      "warnOnly": ["W-SCOPE", "W-PATHS"]
    },
    "feature": {
      "path": [
        "planned",
        "policy-ready",
        "ready",
        "implementing",
        "reviewing",
        "merged",
        "evidenced"
      ],
      "steps": [],
      "skip": [],
      "warnOnly": []
    },
    "policy-change": {
      "path": [
        "planned",
        "policy-ready",
        "ready",
        "implementing",
        "reviewing",
        "merged",
        "evidenced"
      ],
      "steps": [],
      "skip": [],
      "warnOnly": []
    }
  },
  "checks": [
    {
      "id": "W-SCOPE",
      "module": "scripts/ci/lifecycle/policy-first-check.mjs",
      "guard": "W-SCOPE"
    },
    {
      "id": "W-POLICY",
      "module": "scripts/ci/lifecycle/policy-first-check.mjs",
      "guard": "W-POLICY"
    },
    {
      "id": "W-CITE",
      "module": "scripts/ci/lifecycle/policy-first-check.mjs",
      "guard": "W-READY"
    },
    { "id": "W-IRREV", "module": "scripts/ci/lifecycle/policy-first-check.mjs", "guard": null },
    { "id": "L-CONFIRM", "module": "scripts/ci/lifecycle/policy-first-check.mjs", "guard": null },
    { "id": "W-AREA", "module": "scripts/ci/lifecycle/area-criteria-check.mjs", "guard": null },
    {
      "id": "W-REVIEW",
      "module": "scripts/ci/lifecycle/review-snapshot-check.mjs",
      "guard": "W-REVIEW"
    },
    { "id": "W-CAUSE", "module": "scripts/ci/lifecycle/review-snapshot-check.mjs", "guard": null }
  ]
}
